<li>
    <a class="source-legend-item@(Count == 0 ? " is-zero" : string.Empty)" href="@Href">
        <span class="source-dot @DotClass"></span>
        <span class="source-legend-label">@Label</span>
        <strong>@Count.ToString("N0", CultureInfo.CurrentCulture)</strong>
    </a>
</li>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = default!;

    [Parameter, EditorRequired]
    public string DotClass { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;

    [Parameter, EditorRequired]
    public int Count { get; set; }
}
