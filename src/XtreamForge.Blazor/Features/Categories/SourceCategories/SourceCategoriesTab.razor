@namespace XtreamForge.Blazor.Features.Categories.SourceCategories

<section class="categories-tab-panel">
    <header class="categories-panel-header">
        <div>
            <h2>Source Categories</h2>
            <p class="category-meta">Manual disabled wins first. Otherwise the first enabled rule match decides whether the source category stays enabled or is excluded.</p>
        </div>
        <FluentBadge Appearance="Appearance.Neutral">@Rows.Count of @TotalCount categories</FluentBadge>
    </header>

    <div class="categories-toolbar-grid">
        <FluentSelect TOption="string" Value="@FormatNullableInt(SelectedSourceId)" ValueChanged="HandleSourceChangedAsync" Disabled="@(Sources.Count == 0)" Label="Source">
            @if (Sources.Count == 0)
            {
                <FluentOption Value="">No sources</FluentOption>
            }
            else
            {
                @foreach (var source in Sources)
                {
                    <FluentOption Value="@source.Id.ToString(CultureInfo.InvariantCulture)">@source.DisplayName</FluentOption>
                }
            }
        </FluentSelect>

        <FluentSelect TOption="string" Value="@SelectedContentType.ToString()" ValueChanged="HandleContentTypeChangedAsync" Label="Content Type">
            <FluentOption Value="@AdminContentType.Vod.ToString()">VOD</FluentOption>
            <FluentOption Value="@AdminContentType.Series.ToString()">Series</FluentOption>
        </FluentSelect>

        <div class="toolbar-actions">
            <FluentButton Appearance="Appearance.Accent" @onclick="OnOpenAddSource">
                <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Slot="start" />
                <span>Add Source</span>
            </FluentButton>
        </div>
    </div>

    <div class="categories-toolbar-grid categories-toolbar-grid-secondary">
        <FluentSearch Value="@SearchText"
                      ValueChanged="OnSearchChanged"
                      Immediate="true"
                      ImmediateDelay="200"
                      Placeholder="Search categories..."
                      Label="Search" />

        <FluentSelect TOption="string" Value="@StatusFilter.ToString()" ValueChanged="HandleStatusFilterChangedAsync" Label="Status">
            <FluentOption Value="@CategoryStatusFilter.All.ToString()">All</FluentOption>
            <FluentOption Value="@CategoryStatusFilter.Enabled.ToString()">Enabled</FluentOption>
            <FluentOption Value="@CategoryStatusFilter.Disabled.ToString()">Disabled</FluentOption>
        </FluentSelect>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <FluentMessageBar Title="Source categories" Intent="@MessageIntent.Success" AllowDismiss="false">@Message</FluentMessageBar>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <FluentMessageBar Title="Source categories" Intent="@MessageIntent.Error" AllowDismiss="false">@ErrorMessage</FluentMessageBar>
    }

    @if (Sources.Count == 0)
    {
        <FluentCard Class="empty-state">
            <p>No sources discovered yet. Add a source to import categories, then normal Xtream traffic will keep discovery fresh.</p>
        </FluentCard>
    }
    else if (TotalCount == 0)
    {
        <FluentCard Class="empty-state">
            <p>No categories have been discovered for this source and content type yet.</p>
        </FluentCard>
    }
    else if (Rows.Count == 0)
    {
        <FluentCard Class="empty-state">
            <p>No categories match the current search and status filters.</p>
        </FluentCard>
    }
    else
    {
        <div class="table-scroll">
            <FluentDataGrid Items="@Rows.AsQueryable()"
                            TGridItem="CategoryRowState"
                            DisplayMode="DataGridDisplayMode.Table"
                            GridTemplateColumns="2.2fr 2fr 1.1fr 1.4fr"
                            RowSize="DataGridRowSize.Small"
                            MultiLine="true"
                            Class="categories-grid">
                <TemplateColumn Title="Source Category">
                    <div class="category-name">@context.Summary.UpstreamCategoryName</div>
                    <div class="category-meta">Upstream ID @context.Summary.UpstreamCategoryId · XtreamForge ID @context.Summary.DedicatedXtreamForgeCategoryId</div>
                </TemplateColumn>
                <TemplateColumn Title="Mapping">
                    <div class="mapping-cell">
                        <div class="mapping-control-row">
                            <FluentSelect TOption="string" @bind-Value="context.MappingValue" @bind-Value:after="() => OnMappingChanged.InvokeAsync(context)" Disabled="@context.IsBusy" AriaLabel="Category mapping">
                                <FluentOption Value="disabled">Disabled</FluentOption>
                                <FluentOption Value="original">Original</FluentOption>
                                <FluentOption Value="new">New category</FluentOption>
                                @foreach (var customCategory in CustomCategories)
                                {
                                    <FluentOption Value="@CategoryRowState.GetCustomMappingValue(customCategory.Summary.Id)">@customCategory.Summary.DisplayName</FluentOption>
                                }
                            </FluentSelect>

                            @switch (context.SaveState)
                            {
                                case MutationFeedbackState.Saving:
                                    <FluentProgressRing Width="18px" />
                                    break;
                                case MutationFeedbackState.Saved:
                                    <FluentBadge Appearance="Appearance.Lightweight">Saved</FluentBadge>
                                    break;
                            }
                        </div>

                        @if (context.IsCreatingCustomCategory)
                        {
                            <div class="inline-editor-box">
                                <FluentTextField @bind-Value="context.NewCustomCategoryName" Maxlength="255" Placeholder="Movies 4K" Label="New global custom category" Disabled="@context.IsBusy" />
                                <div class="inline-editor-actions">
                                    <FluentButton Appearance="Appearance.Accent" @onclick="() => OnCreateCustomCategory.InvokeAsync(context)" Disabled="@context.IsBusy">Create &amp; Map</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" @onclick="() => OnCancelCustomCategory.InvokeAsync(context)" Disabled="@context.IsBusy">Cancel</FluentButton>
                                </div>
                            </div>
                        }

                        @if (context.SaveState == MutationFeedbackState.Failed && !string.IsNullOrWhiteSpace(context.ValidationError))
                        {
                            <div class="mapping-feedback">
                                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@context.ValidationError</FluentMessageBar>
                                <FluentButton Appearance="Appearance.Stealth" @onclick="() => OnRetry.InvokeAsync(context)">Retry</FluentButton>
                            </div>
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Status">
                    <FluentBadge Appearance="@(context.Summary.IsEffectivelyIncluded ? Appearance.Accent : Appearance.Neutral)">
                        @CategoriesPageState.FormatEffectiveStatus(context.Summary)
                    </FluentBadge>
                </TemplateColumn>
                <TemplateColumn Title="Rule">
                    @{
                        var matchedRule = CategoriesPageState.FormatMatchedRule(context.Summary);
                        var matchedRuleDetails = CategoriesPageState.FormatMatchedRuleDetails(context.Summary);
                    }
                    @if (context.Summary.MatchedRuleId is not null && matchedRule is not null)
                    {
                        <FluentButton Appearance="Appearance.Stealth" Title="@matchedRuleDetails" @onclick="() => OnOpenRule.InvokeAsync(context)">@matchedRule</FluentButton>
                        @if (!string.IsNullOrWhiteSpace(matchedRuleDetails))
                        {
                            <div class="category-meta">@matchedRuleDetails</div>
                        }
                    }
                    else
                    {
                        <span class="category-meta">—</span>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</section>

@code {
    [Parameter]
    public required IReadOnlyList<AdminSource> Sources { get; set; }

    [Parameter]
    public int? SelectedSourceId { get; set; }

    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public CategoryStatusFilter StatusFilter { get; set; }

    [Parameter]
    public required IReadOnlyList<CategoryRowState> Rows { get; set; }

    [Parameter]
    public required int TotalCount { get; set; }

    [Parameter]
    public required IReadOnlyList<CustomCategoryRowState> CustomCategories { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<int?> OnSourceChanged { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnSearchChanged { get; set; }

    [Parameter]
    public EventCallback<CategoryStatusFilter> OnStatusFilterChanged { get; set; }

    [Parameter]
    public EventCallback OnOpenAddSource { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnMappingChanged { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnCreateCustomCategory { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnCancelCustomCategory { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnRetry { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnOpenRule { get; set; }

    private static string FormatNullableInt(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private Task HandleSourceChangedAsync(string? value) =>
        OnSourceChanged.InvokeAsync(int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var parsedValue) ? parsedValue : null);

    private Task HandleContentTypeChangedAsync(string? value) =>
        Enum.TryParse<AdminContentType>(value, true, out var contentType)
            ? OnContentTypeChanged.InvokeAsync(contentType)
            : Task.CompletedTask;

    private Task HandleStatusFilterChangedAsync(string? value) =>
        Enum.TryParse<CategoryStatusFilter>(value, true, out var statusFilter)
            ? OnStatusFilterChanged.InvokeAsync(statusFilter)
            : Task.CompletedTask;
}
