    private async Task DropRuleAsync(RuleDropRequest request)
    {
        if (_selectedSourceId is null)
        {
            return;
        }

        var currentIndex = _ruleRows.FindIndex(rule => rule.RuleId == request.DraggedRuleId);
        if (currentIndex < 0)
        {
            return;
        }

        var orderedIds = _ruleRows.Select(rule => rule.RuleId).ToList();
        var originalOrder = orderedIds.ToList();
        var draggedId = orderedIds[currentIndex];
        orderedIds.RemoveAt(currentIndex);
        var targetIndex = request.TargetIndex;
        if (targetIndex > currentIndex)
        {
            targetIndex--;
        }

        orderedIds.Insert(Math.Clamp(targetIndex, 0, orderedIds.Count), draggedId);

        if (orderedIds.SequenceEqual(originalOrder))
        {
            return;
        }

        try
        {
            _ruleMessage = null;
            _ruleErrorMessage = null;
            await CategoriesClient.ReorderRulesAsync(new AdminCategoryRuleOrderUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
                orderedIds));
            await RefreshRulesAndCategoryViewsAsync("Rule order updated.", draggedId);
        }
        catch (Exception exception)
        {
            _ruleErrorMessage = exception.Message;
        }
    }

