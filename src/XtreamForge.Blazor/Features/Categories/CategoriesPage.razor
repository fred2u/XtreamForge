    private async Task RunRuleTesterAsync()
    {
        if (_selectedSourceId is null)
        {
            _ruleTester.ErrorMessage = "A source must be selected.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_ruleTester.CategoryName))
        {
            _ruleTester.ErrorMessage = "Enter a category name to test.";
            return;
        }

        _ruleTester.SaveState = MutationFeedbackState.Saving;
        _ruleTester.ErrorMessage = null;

        try
        {
            _ruleTester.Preview = await CategoriesClient.PreviewRuleAsync(_selectedSourceId.Value, _selectedContentType, _ruleTester.CategoryName);
            _ruleTester.SaveState = MutationFeedbackState.Saved;
        }
        catch (Exception exception)
        {
            _ruleTester.Preview = null;
            _ruleTester.ErrorMessage = exception.Message;
            _ruleTester.SaveState = MutationFeedbackState.Failed;
        }
    }

    private void BeginRuleDrag(int ruleId)
    {
        _draggedRuleId = ruleId;
        _dropTargetIndex = _ruleRows.FindIndex(rule => rule.RuleId == ruleId);
    }

    private Task EndRuleDrag()
    {
        _draggedRuleId = null;
        _dropTargetIndex = null;
        return Task.CompletedTask;
    }

    private Task SetRuleDropTarget(int index)
    {
        _dropTargetIndex = index;
        return Task.CompletedTask;
    }

    private async Task DropRuleAtIndexAsync(int index)
    {
        if (_draggedRuleId is null || _selectedSourceId is null)
        {
            return;
        }

        var currentIndex = _ruleRows.FindIndex(rule => rule.RuleId == _draggedRuleId.Value);
        if (currentIndex < 0)
        {
            await EndRuleDrag();
            return;
        }

        var orderedIds = _ruleRows.Select(rule => rule.RuleId).ToList();
        var originalOrder = orderedIds.ToList();
        var draggedId = orderedIds[currentIndex];
        orderedIds.RemoveAt(currentIndex);
        if (index > currentIndex)
        {
            index--;
        }

        orderedIds.Insert(Math.Clamp(index, 0, orderedIds.Count), draggedId);

        await EndRuleDrag();

        if (orderedIds.SequenceEqual(originalOrder))
        {
            return;
        }

        try
        {
            _ruleMessage = null;
            _ruleErrorMessage = null;
            await CategoriesClient.ReorderRulesAsync(new AdminCategoryRuleOrderUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
                orderedIds));
            await RefreshRulesAndCategoryViewsAsync("Rule order updated.", draggedId);
        }
        catch (Exception exception)
        {
            _ruleErrorMessage = exception.Message;
        }
    }

