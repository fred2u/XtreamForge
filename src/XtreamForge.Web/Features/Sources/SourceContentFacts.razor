@using XtreamForge.Web.Features.Categories

<section class="source-block" aria-label="@Title">
    <header class="source-block-header">
        <h3 class="source-block-title">
            <FluentIcon Value="@Icon" aria-hidden="true" />
            @Title
        </h3>
        @if (Summary.Categories > 0)
        {
            <a class="text-link source-block-headline" href="@CategoriesHref("decision=Included")">
                <strong>@Format(Summary.EffectiveCategories)</strong>&nbsp;of&nbsp;@Format(Summary.Categories) sent
            </a>
        }
    </header>

    @if (Summary.Categories == 0)
    {
        <p class="source-block-empty">No @(IsVod ? "movie" : "series") category discovered for this source.</p>
    }
    else
    {
        <div class="source-bar" role="img" aria-label="@BarDescription">
            <span class="source-bar-segment source-bar-sent" style="flex-grow: @Summary.EffectiveCategories"></span>
            <span class="source-bar-segment source-bar-manual" style="flex-grow: @Summary.ManuallyExcludedCategories"></span>
            <span class="source-bar-segment source-bar-provider" style="flex-grow: @Summary.ProviderDisabledCategories"></span>
            <span class="source-bar-segment source-bar-rule" style="flex-grow: @Summary.RuleExcludedCategories"></span>
        </div>

        <ul class="source-legend" aria-label="Categories by outcome">
            <LegendItem Href="@CategoriesHref("decision=Included")" DotClass="source-bar-sent" Label="Sent to clients" Count="@Summary.EffectiveCategories" />
            <LegendItem Href="@CategoriesHref("manual=Excluded")" DotClass="source-bar-manual" Label="Excluded manually" Count="@Summary.ManuallyExcludedCategories" />
            <LegendItem Href="@CategoriesHref("provider=Disabled")" DotClass="source-bar-provider" Label="Disabled by the provider" Count="@Summary.ProviderDisabledCategories" />
            <LegendItem Href="@CategoriesHref("decision=Excluded", "manual=NotExcluded", "provider=Enabled")" DotClass="source-bar-rule" Label="Excluded by a rule" Count="@Summary.RuleExcludedCategories" />
        </ul>
    }

    <ul class="source-links" aria-label="Related settings">
        <li><a class="source-link@(ZeroClass(Summary.MappedCategories))" href="@CategoriesHref("mapping=Mapped")"><FluentIcon Value="@(new Icons.Regular.Size16.Tag())" aria-hidden="true" /><strong>@Format(Summary.MappedCategories)</strong> mapped</a></li>
        <li><a class="source-link@(ZeroClass(Summary.CategoryRules))" href="@($"/categories/rules?{Scope}")"><FluentIcon Value="@(new Icons.Regular.Size16.Filter())" aria-hidden="true" /><strong>@Format(Summary.CategoryRules)</strong> category @(Summary.CategoryRules == 1 ? "rule" : "rules")</a></li>
        <li><a class="source-link@(ZeroClass(Summary.ItemRules))" href="@($"/items/rules?{Scope}")"><FluentIcon Value="@(new Icons.Regular.Size16.Filter())" aria-hidden="true" /><strong>@Format(Summary.ItemRules)</strong> item @(Summary.ItemRules == 1 ? "rule" : "rules")</a></li>
        <li><span class="source-link@(ZeroClass(Summary.TmdbMappings))" title="Streams whose TMDB ID is known (StreamId → TmdbId), resolved in the background"><FluentIcon Value="@(new Icons.Regular.Size16.Link())" aria-hidden="true" /><strong>@Format(Summary.TmdbMappings)</strong> TMDB @(Summary.TmdbMappings == 1 ? "ID" : "IDs")</span></li>
    </ul>
</section>

@code {
    [Parameter, EditorRequired]
    public int SourceId { get; set; }

    [Parameter, EditorRequired]
    public ContentType ContentType { get; set; }

    [Parameter, EditorRequired]
    public SourceContentSummaryDto Summary { get; set; } = default!;

    private bool IsVod => ContentType == ContentType.Vod;

    private string Title => IsVod ? "Movies (VOD)" : "Series";

    private Icon Icon => IsVod ? new Icons.Regular.Size20.Video() : new Icons.Regular.Size20.Tv();

    private string Scope => $"source={SourceId}&type={ContentType}";

    private string BarDescription =>
        $"{Format(Summary.EffectiveCategories)} sent to clients, {Format(Summary.ManuallyExcludedCategories)} excluded manually, "
        + $"{Format(Summary.ProviderDisabledCategories)} disabled by the provider, {Format(Summary.RuleExcludedCategories)} excluded by a rule";

    private string CategoriesHref(params string[] filters) =>
        $"/categories/xtream?{Scope}{string.Concat(filters.Select(filter => "&" + filter))}";

    private static string ZeroClass(int value) => value == 0 ? " is-zero" : string.Empty;

    private static string Format(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
}
