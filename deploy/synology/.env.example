# Copier ce fichier en .env à côté de docker-compose.yml (le .env n'est jamais commité : *.env est dans .gitignore)

# Ports sur le NAS
API_PORT=8080
ADMIN_PORT=8081

# Jeton d'accès en lecture TMDB (themoviedb.org > Paramètres > API, le long jeton « lecture »), obligatoire :
# sans lui aucune métadonnée n'est chargée et le catalogue reste vide
TMDB_API_KEY=

# Hôte du fournisseur Xtream, sans http:// ni port (obligatoire)
XTREAM_HOST=monfournisseur.com

# Mot de passe de la base, à inventer (long)
POSTGRES_PASSWORD=change-moi
