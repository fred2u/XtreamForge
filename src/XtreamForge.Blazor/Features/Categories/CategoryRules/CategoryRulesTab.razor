@namespace XtreamForge.Blazor.Features.Categories.CategoryRules
@using XtreamForge.Blazor.Components.Shared

<section class="categories-tab-panel">
    <header class="categories-panel-header">
        <div>
            <h2>Category Rules</h2>
            <p class="category-meta">Rules are evaluated in order. First match wins.</p>
        </div>
        @if (IsRefreshing)
        {
            <div class="categories-count">Refreshing…</div>
        }
    </header>

    <div class="categories-toolbar-grid">
        <label>
            Source
            <select value="@FormatNullableInt(SelectedSourceId)" @onchange="HandleSourceChangedAsync" disabled="@(Sources.Count == 0)">
                @if (Sources.Count == 0)
                {
                    <option value="">No sources</option>
                }
                else
                {
                    @foreach (var source in Sources)
                    {
                        <option value="@source.Id">@source.DisplayName</option>
                    }
                }
            </select>
        </label>

        <label>
            Content Type
            <select value="@SelectedContentType.ToString()" @onchange="HandleContentTypeChangedAsync">
                <option value="@AdminContentType.Vod">VOD</option>
                <option value="@AdminContentType.Series">Series</option>
            </select>
        </label>

        <div class="toolbar-actions">
            <button type="button" @onclick="() => OnOpenCreate.InvokeAsync()" disabled="@(!HasSelectedSource)">+ Add rule</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message) || !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="panel-feedback">
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="inline-success">@Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="inline-error">@ErrorMessage</div>
            }
        </div>
    }

    <div class="rule-editor-card">
        <h3>Rule Tester</h3>
        <div class="rule-tester-grid">
            <label>
                Category name
                <InputText @bind-Value="Tester.CategoryName" maxlength="255" placeholder="|FR| DOCUMENTAIRE SPORT" disabled="@(!HasSelectedSource || Tester.IsBusy)" />
            </label>
            <div class="rule-action-cell">
                <button type="button" @onclick="() => OnRunTester.InvokeAsync()" disabled="@(!HasSelectedSource || Tester.IsBusy)">@(Tester.IsBusy ? "Testing…" : "Test rule")</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Tester.ErrorMessage))
        {
            <div class="inline-error">@Tester.ErrorMessage</div>
        }
        else if (Tester.Preview is not null)
        {
            <div class="rule-tester-result">
                <strong>@(Tester.Preview.Decision == "Exclude" ? "Excluded" : "Included")</strong>
                @if (Tester.Preview.MatchedRuleId is int && Tester.Preview.MatchedRuleSequence is int matchedRuleSequence)
                {
                    <div class="category-meta">Matched rule #@matchedRuleSequence · @Tester.Preview.MatchedRuleAction · @Tester.Preview.MatchedPattern</div>
                }
                else
                {
                    <div class="category-meta">No rule matched. Default include applies.</div>
                }
            </div>
        }
    </div>

    @if (!HasSelectedSource)
    {
        <div class="empty-state">
            <p>Select a source to manage rules.</p>
        </div>
    }
    else if (Rows.Count == 0)
    {
        <div class="empty-state">
            <p>No rules configured for this source and content type.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="category-grid rules-grid">
                <thead>
                    <tr>
                        <th class="drag-column"></th>
                        <th>#</th>
                        <th>Action</th>
                        <th>Match</th>
                        <th>Pattern</th>
                        <th>Case</th>
                        <th>Enabled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Rows.Count; index++)
                    {
                        var rule = Rows[index];
                        <tr @key="rule.RuleId"
                            class="@GetRowClass(rule, index)"
                            @ondragover:preventDefault
                            @ondragenter="() => OnDropTargetChanged.InvokeAsync(index)"
                            @ondrop="() => OnDropAtIndex.InvokeAsync(index)">
                            <td class="drag-column">
                                <span class="drag-handle"
                                      title="Drag to reorder"
                                      aria-label="Drag to reorder"
                                      draggable="@rule.CanRunSecondaryActions"
                                      @ondragstart="() => OnDragStart.InvokeAsync(rule.RuleId)"
                                      @ondragend="() => OnDragEnd.InvokeAsync()">
                                    <AppIcon Name="drag" />
                                </span>
                            </td>
                            <td class="rule-sequence-cell">@rule.Sequence</td>
                            @if (rule.IsEditing)
                            {
                                <td>
                                    <InputSelect @bind-Value="rule.Action" disabled="@rule.IsBusy">
                                        <option value="@CategoryRuleActionOption.Include">Include</option>
                                        <option value="@CategoryRuleActionOption.Exclude">Exclude</option>
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputSelect @bind-Value="rule.Operator" disabled="@rule.IsBusy">
                                        <option value="@CategoryRuleOperatorOption.Contains">Contains</option>
                                        <option value="@CategoryRuleOperatorOption.StartsWith">StartsWith</option>
                                    </InputSelect>
                                </td>
                                <td><InputText @bind-Value="rule.Pattern" maxlength="255" disabled="@rule.IsBusy" /></td>
                                <td>
                                    <label class="checkbox-label compact-checkbox-label">
                                        <InputCheckbox @bind-Value="rule.CaseSensitive" disabled="@rule.IsBusy" />
                                        Case sensitive
                                    </label>
                                </td>
                                <td>
                                    <label class="checkbox-label compact-checkbox-label">
                                        <InputCheckbox @bind-Value="rule.IsEnabled" disabled="@rule.IsBusy" />
                                        Enabled
                                    </label>
                                </td>
                            }
                            else
                            {
                                <td>@rule.Action</td>
                                <td>@rule.Operator</td>
                                <td>@rule.Pattern</td>
                                <td>@(rule.CaseSensitive ? "Case sensitive" : "Ignore case")</td>
                                <td>@(rule.IsEnabled ? "Yes" : "No")</td>
                            }
                            <td>
                                <div class="row-actions">
                                    @if (rule.IsEditing)
                                    {
                                        <button type="button" @onclick="() => OnSave.InvokeAsync(rule)" disabled="@rule.IsBusy">@(rule.IsBusy ? "Saving…" : "Save")</button>
                                        <button type="button" class="secondary-button" @onclick="() => OnCancelEdit.InvokeAsync(rule)" disabled="@rule.IsBusy">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="icon-button" title="Edit rule" aria-label="Edit rule" @onclick="() => OnBeginEdit.InvokeAsync(rule)" disabled="@rule.IsBusy">
                                            <AppIcon Name="edit" />
                                        </button>
                                    }
                                    <button type="button"
                                            class="icon-button"
                                            title="@(rule.IsEnabled ? "Disable rule" : "Enable rule")"
                                            aria-label="@(rule.IsEnabled ? "Disable rule" : "Enable rule")"
                                            @onclick="() => OnToggleEnabled.InvokeAsync(rule)"
                                            disabled="@(!rule.CanRunSecondaryActions)">
                                        <AppIcon Name="power" />
                                    </button>
                                    <button type="button"
                                            class="icon-button danger-button"
                                            title="Delete rule"
                                            aria-label="Delete rule"
                                            @onclick="() => OnRequestDelete.InvokeAsync(rule)"
                                            disabled="@(!rule.CanRunSecondaryActions)">
                                        <AppIcon Name="trash" />
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rule.Message))
                                {
                                    <div class="@(rule.SaveState == MutationFeedbackState.Failed ? "inline-error" : "category-meta")">@rule.Message</div>
                                }
                            </td>
                        </tr>
                    }

                    @if (DraggedRuleId is not null)
                    {
                        <tr class="rule-drop-zone @(DropTargetIndex == Rows.Count ? "active" : null)"
                            @ondragover:preventDefault
                            @ondragenter="() => OnDropTargetChanged.InvokeAsync(Rows.Count)"
                            @ondrop="() => OnDropAtIndex.InvokeAsync(Rows.Count)">
                            <td colspan="8">
                                <div class="rule-drop-indicator"></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public required IReadOnlyList<AdminSource> Sources { get; set; }

    [Parameter]
    public int? SelectedSourceId { get; set; }

    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public required IReadOnlyList<RuleRowState> Rows { get; set; }

    [Parameter]
    public required RuleTesterState Tester { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public int? HighlightedRuleId { get; set; }

    [Parameter]
    public int? DraggedRuleId { get; set; }

    [Parameter]
    public int? DropTargetIndex { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnOpenCreate { get; set; }

    [Parameter]
    public EventCallback OnRunTester { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnBeginEdit { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnCancelEdit { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnSave { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnRequestDelete { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnToggleEnabled { get; set; }

    [Parameter]
    public EventCallback<int?> OnSourceChanged { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnDragStart { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    [Parameter]
    public EventCallback<int> OnDropTargetChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnDropAtIndex { get; set; }

    private bool HasSelectedSource => SelectedSourceId is not null;

    private static string FormatNullableInt(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private Task HandleSourceChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        return OnSourceChanged.InvokeAsync(int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var parsedValue) ? parsedValue : null);
    }

    private Task HandleContentTypeChangedAsync(ChangeEventArgs args) =>
        Enum.TryParse<AdminContentType>(args.Value?.ToString(), true, out var value)
            ? OnContentTypeChanged.InvokeAsync(value)
            : Task.CompletedTask;

    private string GetRowClass(RuleRowState rule, int index)
    {
        var classes = new List<string>();

        if (HighlightedRuleId == rule.RuleId)
        {
            classes.Add("highlighted-row");
        }

        if (DraggedRuleId == rule.RuleId)
        {
            classes.Add("dragging-row");
        }

        if (DraggedRuleId is not null && DraggedRuleId != rule.RuleId && DropTargetIndex == index)
        {
            classes.Add("drop-target-row");
        }

        return string.Join(' ', classes);
    }
}
