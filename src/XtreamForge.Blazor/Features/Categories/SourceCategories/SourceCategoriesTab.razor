@namespace XtreamForge.Blazor.Features.Categories.SourceCategories
@using XtreamForge.Blazor.Components.Shared

<section class="categories-tab-panel">
    <header class="categories-panel-header">
        <div>
            <h2>Source Categories</h2>
            <p class="category-meta">Manual disabled wins first. Otherwise the first enabled rule match decides whether the source category stays enabled or is excluded.</p>
        </div>
        <div class="categories-count">@Rows.Count of @TotalCount categories</div>
    </header>

    <div class="categories-toolbar-grid">
        <label>
            Source
            <select value="@FormatNullableInt(SelectedSourceId)" @onchange="HandleSourceChangedAsync" disabled="@(Sources.Count == 0)">
                @if (Sources.Count == 0)
                {
                    <option value="">No sources</option>
                }
                else
                {
                    @foreach (var source in Sources)
                    {
                        <option value="@source.Id">@source.DisplayName</option>
                    }
                }
            </select>
        </label>

        <label>
            Content Type
            <select value="@SelectedContentType.ToString()" @onchange="HandleContentTypeChangedAsync">
                <option value="@AdminContentType.Vod">VOD</option>
                <option value="@AdminContentType.Series">Series</option>
            </select>
        </label>

        <div class="toolbar-actions">
            <button type="button" @onclick="OnOpenAddSource">+ Add source</button>
        </div>
    </div>

    <div class="categories-toolbar-grid categories-toolbar-grid-secondary">
        <label>
            Search
            <DebouncedTextInput Value="@SearchText" ValueChanged="OnSearchChanged" Placeholder="Search categories..." />
        </label>

        <label>
            Status
            <select value="@StatusFilter.ToString()" @onchange="HandleStatusFilterChangedAsync">
                <option value="@CategoryStatusFilter.All">All</option>
                <option value="@CategoryStatusFilter.Enabled">Enabled</option>
                <option value="@CategoryStatusFilter.Disabled">Disabled</option>
            </select>
        </label>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message) || !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="panel-feedback">
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="inline-success">@Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="inline-error">@ErrorMessage</div>
            }
        </div>
    }

    @if (Sources.Count == 0)
    {
        <div class="empty-state">
            <p>No sources discovered yet. Add a source to import categories, then normal Xtream traffic will keep discovery fresh.</p>
        </div>
    }
    else if (TotalCount == 0)
    {
        <div class="empty-state">
            <p>No categories have been discovered for this source and content type yet.</p>
        </div>
    }
    else if (Rows.Count == 0)
    {
        <div class="empty-state">
            <p>No categories match the current search and status filters.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="category-grid">
                <thead>
                    <tr>
                        <th>Source Category</th>
                        <th>Mapping</th>
                        <th>Status</th>
                        <th>Rule</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        var matchedRule = CategoriesPageState.FormatMatchedRule(row.Summary);
                        var matchedRuleDetails = CategoriesPageState.FormatMatchedRuleDetails(row.Summary);

                        <tr @key="row.Summary.Id">
                            <td>
                                <div class="category-name">@row.Summary.UpstreamCategoryName</div>
                                <div class="category-meta">Upstream ID @row.Summary.UpstreamCategoryId · XtreamForge ID @row.Summary.DedicatedXtreamForgeCategoryId</div>
                            </td>
                            <td>
                                <InputSelect @bind-Value="row.MappingValue" @bind-Value:after="() => OnMappingChanged.InvokeAsync(row)" disabled="@row.IsBusy">
                                    <option value="disabled">Disabled</option>
                                    <option value="original">Original</option>
                                    <option value="new">New category</option>
                                    @if (CustomCategories.Count > 0)
                                    {
                                        <optgroup label="Global custom categories">
                                            @foreach (var customCategory in CustomCategories)
                                            {
                                                <option value="@CategoryRowState.GetCustomMappingValue(customCategory.Summary.Id)">@customCategory.Summary.DisplayName</option>
                                            }
                                        </optgroup>
                                    }
                                </InputSelect>

                                @if (row.IsCreatingCustomCategory)
                                {
                                    <div class="inline-editor-box">
                                        <label>
                                            New global custom category
                                            <InputText @bind-Value="row.NewCustomCategoryName" maxlength="255" placeholder="Movies 4K" disabled="@row.IsBusy" />
                                        </label>
                                        <div class="inline-editor-actions">
                                            <button type="button" @onclick="() => OnCreateCustomCategory.InvokeAsync(row)" disabled="@row.IsBusy">Create &amp; map</button>
                                            <button type="button" class="secondary-button" @onclick="() => OnCancelCustomCategory.InvokeAsync(row)" disabled="@row.IsBusy">Cancel</button>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="status-badge @(row.Summary.IsEffectivelyIncluded ? "status-badge-enabled" : "status-badge-disabled")">
                                    @CategoriesPageState.FormatEffectiveStatus(row.Summary)
                                </span>
                            </td>
                            <td>
                                @if (row.Summary.MatchedRuleId is not null && matchedRule is not null)
                                {
                                    <button type="button" class="link-button rule-link" title="@matchedRuleDetails" @onclick="() => OnOpenRule.InvokeAsync(row)">@matchedRule</button>
                                    @if (!string.IsNullOrWhiteSpace(matchedRuleDetails))
                                    {
                                        <div class="category-meta">@matchedRuleDetails</div>
                                    }
                                }
                                else
                                {
                                    <span class="category-meta">—</span>
                                }
                            </td>
                            <td>
                                @switch (row.SaveState)
                                {
                                    case MutationFeedbackState.Saving:
                                        <span class="category-meta">Saving…</span>
                                        break;
                                    case MutationFeedbackState.Saved:
                                        <span class="inline-success">Saved</span>
                                        break;
                                    case MutationFeedbackState.Failed:
                                        <div class="inline-error">@row.ValidationError</div>
                                        <button type="button" class="link-button" @onclick="() => OnRetry.InvokeAsync(row)">Retry</button>
                                        break;
                                    default:
                                        <span class="category-meta">—</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public required IReadOnlyList<AdminSource> Sources { get; set; }

    [Parameter]
    public int? SelectedSourceId { get; set; }

    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public CategoryStatusFilter StatusFilter { get; set; }

    [Parameter]
    public required IReadOnlyList<CategoryRowState> Rows { get; set; }

    [Parameter]
    public required int TotalCount { get; set; }

    [Parameter]
    public required IReadOnlyList<CustomCategoryRowState> CustomCategories { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback<int?> OnSourceChanged { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<string?> OnSearchChanged { get; set; }

    [Parameter]
    public EventCallback<CategoryStatusFilter> OnStatusFilterChanged { get; set; }

    [Parameter]
    public EventCallback OnOpenAddSource { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnMappingChanged { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnCreateCustomCategory { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnCancelCustomCategory { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnRetry { get; set; }

    [Parameter]
    public EventCallback<CategoryRowState> OnOpenRule { get; set; }

    private static string FormatNullableInt(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private Task HandleSourceChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        return OnSourceChanged.InvokeAsync(int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var parsedValue) ? parsedValue : null);
    }

    private Task HandleContentTypeChangedAsync(ChangeEventArgs args) =>
        Enum.TryParse<AdminContentType>(args.Value?.ToString(), true, out var value)
            ? OnContentTypeChanged.InvokeAsync(value)
            : Task.CompletedTask;

    private Task HandleStatusFilterChangedAsync(ChangeEventArgs args) =>
        Enum.TryParse<CategoryStatusFilter>(args.Value?.ToString(), true, out var value)
            ? OnStatusFilterChanged.InvokeAsync(value)
            : Task.CompletedTask;
}
