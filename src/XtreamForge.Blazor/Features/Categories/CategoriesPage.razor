@page "/categories"
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using XtreamForge.Blazor.Components.Shared
@using XtreamForge.Blazor.Features.Categories.CategoryRules
@using XtreamForge.Blazor.Features.Categories.CustomCategories
@using XtreamForge.Blazor.Features.Categories.SourceCategories
@inject CategoriesClient CategoriesClient
@inject NavigationManager NavigationManager

<PageTitle>Categories - XtreamForge</PageTitle>

<h1>Categories</h1>
<p class="page-subtitle">Compact source-category administration backed by the existing XtreamForge APIs and PostgreSQL configuration.</p>

@if (_isLoading)
{
    <section class="status-card categories-shell-card">
        <div class="categories-skeleton-title"></div>
        <div class="categories-skeleton-toolbar"></div>
        <div class="categories-skeleton-block"></div>
    </section>
}
else if (_categoryView is null || _rulesView is null)
{
    <section class="status-card categories-shell-card">
        <h2>Unable to load category administration</h2>
        <p>Try again after the backend and database are available.</p>
        @if (!string.IsNullOrWhiteSpace(_pageErrorMessage))
        {
            <p class="inline-error">@_pageErrorMessage</p>
        }
    </section>
}
else
{
    <section class="status-card categories-shell-card">
        <div class="categories-tab-strip" role="tablist" aria-label="Categories administration sections">
            @foreach (var tab in _tabs)
            {
                <button
                    type="button"
                    id="@GetTabId(tab.Value)"
                    class="categories-tab-button @GetTabCssClass(tab.Value)"
                    role="tab"
                    aria-selected="@(_activeTab == tab.Value)"
                    aria-controls="@GetPanelId(tab.Value)"
                    tabindex="@(_activeTab == tab.Value ? 0 : -1)"
                    @onclick="() => ActivateTab(tab.Value)">
                    @tab.Key
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_pageErrorMessage))
        {
            <div class="inline-error categories-page-error">@_pageErrorMessage</div>
        }

        @switch (_activeTab)
        {
            case CategoriesTab.SourceCategories:
                <div id="@GetPanelId(CategoriesTab.SourceCategories)" role="tabpanel" aria-labelledby="@GetTabId(CategoriesTab.SourceCategories)">
                    <SourceCategoriesTab
                        Sources="_categoryView.Sources"
                        SelectedSourceId="_selectedSourceId"
                        SelectedContentType="_selectedContentType"
                        SearchText="@_searchText"
                        StatusFilter="_statusFilter"
                        Rows="FilteredCategoryRows"
                        TotalCount="_categoryRows.Count"
                        CustomCategories="_customCategoryRows"
                        Message="@_categoryMessage"
                        ErrorMessage="@_categoryErrorMessage"
                        OnSourceChanged="OnSourceChangedAsync"
                        OnContentTypeChanged="OnContentTypeChangedAsync"
                        OnSearchChanged="OnSearchChangedAsync"
                        OnStatusFilterChanged="OnStatusFilterChangedAsync"
                        OnOpenAddSource="OpenAddSourceDialog"
                        OnMappingChanged="OnMappingSelectionChangedAsync"
                        OnCreateCustomCategory="CreateCustomCategoryAsync"
                        OnCancelCustomCategory="CancelCustomCategoryCreate"
                        OnRetry="RetryCategoryMappingAsync"
                        OnOpenRule="OpenMatchedRuleAsync" />
                </div>
                break;
            case CategoriesTab.CategoryRules:
                <div id="@GetPanelId(CategoriesTab.CategoryRules)" role="tabpanel" aria-labelledby="@GetTabId(CategoriesTab.CategoryRules)">
                    <CategoryRulesTab
                        Sources="_categoryView.Sources"
                        SelectedSourceId="_selectedSourceId"
                        SelectedContentType="_selectedContentType"
                        Rows="_ruleRows"
                        Tester="_ruleTester"
                        IsRefreshing="_isRulesRefreshing"
                        HighlightedRuleId="_highlightedRuleId"
                        DraggedRuleId="_draggedRuleId"
                        DropTargetIndex="_dropTargetIndex"
                        Message="@_ruleMessage"
                        ErrorMessage="@_ruleErrorMessage"
                        OnSourceChanged="OnSourceChangedAsync"
                        OnContentTypeChanged="OnContentTypeChangedAsync"
                        OnOpenCreate="OpenAddRuleDialog"
                        OnRunTester="RunRuleTesterAsync"
                        OnBeginEdit="BeginRuleEdit"
                        OnCancelEdit="CancelRuleEdit"
                        OnSave="SaveRuleAsync"
                        OnRequestDelete="RequestRuleDelete"
                        OnToggleEnabled="ToggleRuleEnabledAsync"
                        OnDragStart="BeginRuleDrag"
                        OnDragEnd="EndRuleDrag"
                        OnDropTargetChanged="SetRuleDropTarget"
                        OnDropAtIndex="DropRuleAtIndexAsync" />
                </div>
                break;
            case CategoriesTab.GlobalCustomCategories:
                <div id="@GetPanelId(CategoriesTab.GlobalCustomCategories)" role="tabpanel" aria-labelledby="@GetTabId(CategoriesTab.GlobalCustomCategories)">
                    <CustomCategoriesTab
                        SelectedContentType="_selectedContentType"
                        Rows="_customCategoryRows"
                        IsRefreshing="_isCategoryDataRefreshing"
                        Message="@_customCategoryMessage"
                        ErrorMessage="@_customCategoryErrorMessage"
                        OnContentTypeChanged="OnContentTypeChangedAsync"
                        OnOpenCreate="OpenNewCustomCategoryDialog"
                        OnBeginEdit="BeginCustomCategoryEdit"
                        OnCancelEdit="CancelCustomCategoryEdit"
                        OnSave="SaveCustomCategoryAsync"
                        OnOpenUsages="OpenCustomCategoryUsagesAsync"
                        OnRequestDelete="RequestCustomCategoryDelete" />
                </div>
                break;
        }
    </section>
}

<ModalDialog IsOpen="@_isAddSourceDialogOpen" Title="Add Xtream source" OnClose="CloseAddSourceDialog">
    <ChildContent>
        <div class="dialog-form-grid">
            <label>
                Protocol
                <select value="@_sourceDiscoveryForm.Protocol" @onchange="HandleSourceDiscoveryProtocolChangedAsync" disabled="@_isSourceDiscoverySaving">
                    <option value="https">HTTPS</option>
                    <option value="http">HTTP</option>
                </select>
            </label>
            <label>
                Host / Base URL
                <InputText @bind-Value="_sourceDiscoveryForm.HostOrBaseUrl" placeholder="example.com" disabled="@_isSourceDiscoverySaving" />
            </label>
            <label>
                Port
                <InputNumber @bind-Value="_sourceDiscoveryForm.Port" disabled="@_isSourceDiscoverySaving" />
            </label>
            <label>
                Username
                <InputText @bind-Value="_sourceDiscoveryForm.Username" disabled="@_isSourceDiscoverySaving" />
            </label>
            <label>
                Password
                <input class="blazor-password-input" type="password" @bind="_sourceDiscoveryForm.Password" disabled="@_isSourceDiscoverySaving" />
            </label>
        </div>

        @if (!string.IsNullOrWhiteSpace(_sourceDiscoveryErrorMessage))
        {
            <div class="inline-error">@_sourceDiscoveryErrorMessage</div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseAddSourceDialog" disabled="@_isSourceDiscoverySaving">Cancel</button>
        <button type="button" @onclick="DiscoverSourceAsync" disabled="@_isSourceDiscoverySaving">@( _isSourceDiscoverySaving ? "Connecting…" : "Connect & import")</button>
    </FooterContent>
</ModalDialog>

<ModalDialog IsOpen="@_isAddRuleDialogOpen" Title="Add category rule" OnClose="CloseAddRuleDialog" IsBusy="@_isRuleCreating">
    <ChildContent>
        <div class="dialog-form-grid">
            <label>
                Action
                <InputSelect @bind-Value="_newRule.Action" disabled="@_isRuleCreating">
                    <option value="@CategoryRuleActionOption.Include">Include</option>
                    <option value="@CategoryRuleActionOption.Exclude">Exclude</option>
                </InputSelect>
            </label>
            <label>
                Match
                <InputSelect @bind-Value="_newRule.Operator" disabled="@_isRuleCreating">
                    <option value="@CategoryRuleOperatorOption.Contains">Contains</option>
                    <option value="@CategoryRuleOperatorOption.StartsWith">StartsWith</option>
                </InputSelect>
            </label>
            <label>
                Pattern
                <InputText @bind-Value="_newRule.Pattern" maxlength="255" disabled="@_isRuleCreating" />
            </label>
            <label>
                Case
                <InputSelect @bind-Value="_newRule.CaseSensitive" disabled="@_isRuleCreating">
                    <option value="false">Ignore case</option>
                    <option value="true">Case sensitive</option>
                </InputSelect>
            </label>
        </div>
        <label class="checkbox-label">
            <InputCheckbox @bind-Value="_newRule.IsEnabled" disabled="@_isRuleCreating" />
            Enabled
        </label>

        @if (!string.IsNullOrWhiteSpace(_ruleCreateErrorMessage))
        {
            <div class="inline-error">@_ruleCreateErrorMessage</div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseAddRuleDialog" disabled="@_isRuleCreating">Cancel</button>
        <button type="button" @onclick="CreateRuleAsync" disabled="@_isRuleCreating">@( _isRuleCreating ? "Adding…" : "Add rule")</button>
    </FooterContent>
</ModalDialog>

<ModalDialog IsOpen="@(_pendingRuleDelete is not null)" Title="Delete category rule?" OnClose="CloseRuleDeleteDialog">
    <ChildContent>
        @if (_pendingRuleDelete is not null)
        {
            <p>@FormatRuleSummary(_pendingRuleDelete)</p>
            <p class="category-meta">This rule will no longer affect matching source categories.</p>
        }
        @if (!string.IsNullOrWhiteSpace(_ruleDeleteErrorMessage))
        {
            <div class="inline-error">@_ruleDeleteErrorMessage</div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseRuleDeleteDialog" disabled="@_isRuleDeleteSaving">Cancel</button>
        <button type="button" class="danger-button" @onclick="DeletePendingRuleAsync" disabled="@_isRuleDeleteSaving">@( _isRuleDeleteSaving ? "Deleting…" : "Delete")</button>
    </FooterContent>
</ModalDialog>

<ModalDialog IsOpen="@_isCustomCategoryUsageDialogOpen" Title="@(_customCategoryUsageTitle ?? "Custom category usage")" OnClose="CloseCustomCategoryUsagesDialog">
    <ChildContent>
        @if (_isCustomCategoryUsageLoading)
        {
            <p>Loading usage…</p>
        }
        else if (!string.IsNullOrWhiteSpace(_customCategoryUsageErrorMessage))
        {
            <div class="inline-error">@_customCategoryUsageErrorMessage</div>
        }
        else
        {
            <p class="category-meta">Used by @_customCategoryUsages.Count source categor@(_customCategoryUsages.Count == 1 ? "y" : "ies").</p>
            <div class="table-scroll">
                <table class="category-grid">
                    <thead>
                        <tr>
                            <th>Source</th>
                            <th>Type</th>
                            <th>Source Category</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usage in _customCategoryUsages)
                        {
                            <tr>
                                <td>@usage.SourceDisplayName</td>
                                <td>@usage.ContentType</td>
                                <td>
                                    <div class="category-name">@usage.UpstreamCategoryName</div>
                                    <div class="category-meta">Upstream ID @usage.UpstreamCategoryId</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseCustomCategoryUsagesDialog">Close</button>
    </FooterContent>
</ModalDialog>

<ModalDialog IsOpen="@_isNewCustomCategoryDialogOpen" Title="Create custom category" OnClose="CloseNewCustomCategoryDialog" IsBusy="@_isCustomCategoryCreating">
    <ChildContent>
        <label>
            Content type
            <input value="@_selectedContentType" readonly />
        </label>
        <label>
            Name
            <InputText @bind-Value="_newCustomCategory.DisplayName" maxlength="255" placeholder="Movies 4K" disabled="@_isCustomCategoryCreating" />
        </label>

        @if (!string.IsNullOrWhiteSpace(_customCategoryCreateErrorMessage))
        {
            <div class="inline-error">@_customCategoryCreateErrorMessage</div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseNewCustomCategoryDialog" disabled="@_isCustomCategoryCreating">Cancel</button>
        <button type="button" @onclick="CreateStandaloneCustomCategoryAsync" disabled="@_isCustomCategoryCreating">@( _isCustomCategoryCreating ? "Creating…" : "Create")</button>
    </FooterContent>
</ModalDialog>

<ModalDialog IsOpen="@(_pendingCustomCategoryDelete is not null)" Title="Delete custom category?" OnClose="CloseCustomCategoryDeleteDialog">
    <ChildContent>
        @if (_pendingCustomCategoryDelete is not null)
        {
            <p>@_pendingCustomCategoryDelete.DisplayName</p>
            <p class="category-meta">This custom category is unused and can be removed.</p>
        }
        @if (!string.IsNullOrWhiteSpace(_customCategoryDeleteErrorMessage))
        {
            <div class="inline-error">@_customCategoryDeleteErrorMessage</div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="secondary-button" @onclick="CloseCustomCategoryDeleteDialog" disabled="@_isCustomCategoryDeleteSaving">Cancel</button>
        <button type="button" class="danger-button" @onclick="DeletePendingCustomCategoryAsync" disabled="@_isCustomCategoryDeleteSaving">@( _isCustomCategoryDeleteSaving ? "Deleting…" : "Delete")</button>
    </FooterContent>
</ModalDialog>

@code {
    private static readonly IReadOnlyDictionary<string, CategoriesTab> _tabs = new Dictionary<string, CategoriesTab>
    {
        ["Source Categories"] = CategoriesTab.SourceCategories,
        ["Category Rules"] = CategoriesTab.CategoryRules,
        ["Global Custom Categories"] = CategoriesTab.GlobalCustomCategories
    };

    private AdminCategoriesPayload? _categoryView;
    private AdminCategoryRulesPayload? _rulesView;
    private List<CategoryRowState> _categoryRows = [];
    private List<RuleRowState> _ruleRows = [];
    private List<CustomCategoryRowState> _customCategoryRows = [];
    private RuleEditorState _newRule = new() { IsEnabled = true };
    private RuleTesterState _ruleTester = new();
    private CustomCategoryEditorState _newCustomCategory = new();
    private SourceDiscoveryFormState _sourceDiscoveryForm = SourceDiscoveryFormState.CreateDefault();
    private bool _isLoading = true;
    private bool _isCategoryDataRefreshing;
    private bool _isRulesRefreshing;
    private int? _selectedSourceId;
    private AdminContentType _selectedContentType = AdminContentType.Vod;
    private string _searchText = string.Empty;
    private CategoryStatusFilter _statusFilter = CategoryStatusFilter.All;
    private CategoriesTab _activeTab = CategoriesTab.SourceCategories;
    private int? _highlightedRuleId;
    private bool _isRuleCreating;
    private bool _isAddRuleDialogOpen;
    private string? _ruleCreateErrorMessage;
    private bool _isCustomCategoryCreating;
    private bool _isNewCustomCategoryDialogOpen;
    private string? _customCategoryCreateErrorMessage;
    private string? _pageErrorMessage;
    private string? _categoryMessage;
    private string? _categoryErrorMessage;
    private string? _ruleMessage;
    private string? _ruleErrorMessage;
    private string? _customCategoryMessage;
    private string? _customCategoryErrorMessage;
    private bool _isAddSourceDialogOpen;
    private bool _isSourceDiscoverySaving;
    private string? _sourceDiscoveryErrorMessage;
    private RuleRowState? _pendingRuleDelete;
    private bool _isRuleDeleteSaving;
    private string? _ruleDeleteErrorMessage;
    private bool _isCustomCategoryUsageDialogOpen;
    private bool _isCustomCategoryUsageLoading;
    private string? _customCategoryUsageTitle;
    private string? _customCategoryUsageErrorMessage;
    private List<AdminCustomCategoryUsage> _customCategoryUsages = [];
    private CustomCategoryRowState? _pendingCustomCategoryDelete;
    private bool _isCustomCategoryDeleteSaving;
    private string? _customCategoryDeleteErrorMessage;
    private int? _draggedRuleId;
    private int? _dropTargetIndex;

    private IReadOnlyList<CategoryRowState> FilteredCategoryRows => CategoriesPageState.FilterCategoryRows(_categoryRows, _searchText, _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryString();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _pageErrorMessage = null;
        _categoryMessage = null;
        _categoryErrorMessage = null;
        _ruleMessage = null;
        _ruleErrorMessage = null;
        _ruleCreateErrorMessage = null;
        _customCategoryMessage = null;
        _customCategoryErrorMessage = null;
        _customCategoryCreateErrorMessage = null;

        try
        {
            await RefreshAllDataCoreAsync();
        }
        catch (Exception exception)
        {
            _pageErrorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAllDataCoreAsync()
    {
        var categoriesPayload = await CategoriesClient.GetCategoriesAsync(_selectedSourceId, _selectedContentType);
        ApplyCategoryView(categoriesPayload);

        var rulesPayload = await CategoriesClient.GetRulesAsync(_selectedSourceId, _selectedContentType);
        ApplyRulesView(rulesPayload);
    }

    private async Task RefreshCategoriesViewAsync(int? markSavedCategoryId = null, string? message = null)
    {
        _isCategoryDataRefreshing = true;
        _categoryErrorMessage = null;
        _pageErrorMessage = null;

        try
        {
            var payload = await CategoriesClient.GetCategoriesAsync(_selectedSourceId, _selectedContentType);
            ApplyCategoryView(payload);

            if (markSavedCategoryId is int savedCategoryId
                && _categoryRows.SingleOrDefault(row => row.Summary.Id == savedCategoryId) is { } savedRow)
            {
                savedRow.CommitMapping(savedRow.MappingValue);
            }

            _categoryMessage = message;
        }
        catch (Exception exception)
        {
            _categoryErrorMessage = exception.Message;
        }
        finally
        {
            _isCategoryDataRefreshing = false;
        }
    }

    private async Task RefreshRulesAndCategoryViewsAsync(string? message = null, int? highlightRuleId = null)
    {
        _isCategoryDataRefreshing = true;
        _isRulesRefreshing = true;
        _ruleErrorMessage = null;
        _pageErrorMessage = null;

        try
        {
            await RefreshAllDataCoreAsync();
            _highlightedRuleId = highlightRuleId;
            _ruleMessage = message;
            _ruleCreateErrorMessage = null;
        }
        catch (Exception exception)
        {
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _isCategoryDataRefreshing = false;
            _isRulesRefreshing = false;
        }
    }

    private void ApplyCategoryView(AdminCategoriesPayload payload)
    {
        _categoryView = payload;
        _selectedSourceId = payload.SelectedSourceId;
        _selectedContentType = Enum.TryParse<AdminContentType>(payload.SelectedContentType, true, out var parsedContentType)
            ? parsedContentType
            : _selectedContentType;
        _customCategoryRows = payload.CustomCategories.Select(summary => new CustomCategoryRowState(summary)).ToList();
        _categoryRows = payload.UpstreamCategories.Select(summary => new CategoryRowState(summary)).ToList();
    }

    private void ApplyRulesView(AdminCategoryRulesPayload payload)
    {
        _rulesView = payload;
        _ruleRows = payload.Rules.Select(summary => new RuleRowState(summary)).ToList();
        if (_highlightedRuleId is int highlightedRuleId && _ruleRows.All(rule => rule.RuleId != highlightedRuleId))
        {
            _highlightedRuleId = null;
        }
    }

    private void ApplyQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("sourceId", out var sourceValues)
            && int.TryParse(sourceValues[0], NumberStyles.None, CultureInfo.InvariantCulture, out var parsedSourceId))
        {
            _selectedSourceId = parsedSourceId;
        }

        if (query.TryGetValue("contentType", out var contentTypeValues)
            && Enum.TryParse<AdminContentType>(contentTypeValues[0], true, out var parsedContentType))
        {
            _selectedContentType = parsedContentType;
        }
    }

    private Task OnSearchChangedAsync(string? value)
    {
        _searchText = value?.Trim() ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnStatusFilterChangedAsync(CategoryStatusFilter value)
    {
        _statusFilter = value;
        return Task.CompletedTask;
    }

    private void ActivateTab(CategoriesTab tab)
    {
        _activeTab = tab;
    }

    private string GetTabCssClass(CategoriesTab tab) => _activeTab == tab ? "active" : string.Empty;

    private static string GetTabId(CategoriesTab tab) => $"categories-tab-{tab}";

    private static string GetPanelId(CategoriesTab tab) => $"categories-panel-{tab}";

    private async Task OnSourceChangedAsync(int? value)
    {
        _selectedSourceId = value;
        UpdateLocation();
        await ReloadAsync();
    }

    private async Task OnContentTypeChangedAsync(AdminContentType value)
    {
        _selectedContentType = value;
        UpdateLocation();
        await ReloadAsync();
    }

    private void UpdateLocation()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sourceId"] = _selectedSourceId,
            ["contentType"] = _selectedContentType.ToString()
        });

        if (!string.Equals(uri, NavigationManager.Uri, StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(uri, replace: true);
        }
    }

    private async Task OnMappingSelectionChangedAsync(CategoryRowState row)
    {
        _categoryMessage = null;
        _categoryErrorMessage = null;
        row.ClearFeedback();

        if (row.MappingValue == "new")
        {
            row.BeginCustomCategoryCreate();
            return;
        }

        await SaveCategoryMappingAsync(row, row.MappingValue, null);
    }

    private Task CancelCustomCategoryCreate(CategoryRowState row)
    {
        row.CancelCustomCategoryCreate();
        return Task.CompletedTask;
    }

    private Task RetryCategoryMappingAsync(CategoryRowState row) =>
        SaveCategoryMappingAsync(
            row,
            row.PendingMappingValue ?? row.MappingValue,
            row.PendingNewCustomCategoryName ?? row.NewCustomCategoryName);

    private Task OpenMatchedRuleAsync(CategoryRowState row)
    {
        if (row.Summary.MatchedRuleId is int matchedRuleId)
        {
            _highlightedRuleId = matchedRuleId;
            _activeTab = CategoriesTab.CategoryRules;
        }

        return Task.CompletedTask;
    }

    private Task CreateCustomCategoryAsync(CategoryRowState row) =>
        SaveCategoryMappingAsync(row, "new", row.NewCustomCategoryName);

    private async Task SaveCategoryMappingAsync(CategoryRowState row, string mappingValue, string? newCustomCategoryName)
    {
        if (_selectedSourceId is null)
        {
            row.Fail("A source must be selected.");
            return;
        }

        try
        {
            row.BeginSave(mappingValue, newCustomCategoryName);

            var request = mappingValue switch
            {
                "disabled" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Disabled", null, null),
                "original" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Original", null, null),
                "new" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Custom", null, newCustomCategoryName),
                _ when mappingValue.StartsWith("custom:", StringComparison.Ordinal)
                    && int.TryParse(mappingValue[7..], NumberStyles.None, CultureInfo.InvariantCulture, out var customCategoryId)
                    => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Custom", customCategoryId, null),
                _ => throw new InvalidOperationException("Invalid category mapping selection.")
            };

            await CategoriesClient.UpdateCategoryMappingAsync(row.Summary.Id, request);
            await RefreshCategoriesViewAsync(row.Summary.Id, "Mapping saved.");
        }
        catch (Exception exception)
        {
            row.Fail(exception.Message);
        }
    }

    private async Task CreateRuleAsync()
    {
        if (_selectedSourceId is null)
        {
            _ruleCreateErrorMessage = "A source must be selected.";
            return;
        }

        try
        {
            _isRuleCreating = true;
            _ruleMessage = null;
            _ruleErrorMessage = null;
            _ruleCreateErrorMessage = null;

            await CategoriesClient.CreateRuleAsync(new AdminCategoryRuleUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
                _newRule.Action.ToString(),
                _newRule.Operator.ToString(),
                _newRule.Pattern,
                _newRule.CaseSensitive,
                _newRule.IsEnabled));

            ResetAddRuleDialogState();
            await RefreshRulesAndCategoryViewsAsync("Rule created.");
        }
        catch (Exception exception)
        {
            _ruleCreateErrorMessage = exception.Message;
        }
        finally
        {
            _isRuleCreating = false;
        }
    }

    private Task OpenAddRuleDialog()
    {
        if (_selectedSourceId is null)
        {
            _ruleErrorMessage = "Select a source to add a rule.";
            return Task.CompletedTask;
        }

        _isAddRuleDialogOpen = true;
        _ruleCreateErrorMessage = null;
        _newRule = new RuleEditorState { IsEnabled = true };
        return Task.CompletedTask;
    }

    private Task CloseAddRuleDialog()
    {
        ResetAddRuleDialogState();
        return Task.CompletedTask;
    }

    private Task BeginRuleEdit(RuleRowState rule)
    {
        rule.BeginEdit();
        return Task.CompletedTask;
    }

    private Task CancelRuleEdit(RuleRowState rule)
    {
        rule.CancelEdit();
        return Task.CompletedTask;
    }

    private async Task SaveRuleAsync(RuleRowState rule)
    {
        if (_selectedSourceId is null)
        {
            rule.Fail("A source must be selected.");
            return;
        }

        try
        {
            rule.BeginSave();
            await CategoriesClient.UpdateRuleAsync(rule.RuleId, new AdminCategoryRuleUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
                rule.Action.ToString(),
                rule.Operator.ToString(),
                rule.Pattern,
                rule.CaseSensitive,
                rule.IsEnabled));

            rule.CommitSave();
            await RefreshRulesAndCategoryViewsAsync("Rule saved.", rule.RuleId);
        }
        catch (Exception exception)
        {
            rule.Fail(exception.Message);
        }
    }

    private async Task ToggleRuleEnabledAsync(RuleRowState rule)
    {
        if (_selectedSourceId is null)
        {
            rule.Fail("A source must be selected.");
            return;
        }

        if (rule.IsEditing)
        {
            rule.Fail("Save or cancel the current edit before changing the rule state.");
            return;
        }

        var originalValue = rule.IsEnabled;

        try
        {
            rule.IsEnabled = !rule.IsEnabled;
            rule.BeginSave();
            await CategoriesClient.UpdateRuleAsync(rule.RuleId, new AdminCategoryRuleUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
                rule.Action.ToString(),
                rule.Operator.ToString(),
                rule.Pattern,
                rule.CaseSensitive,
                rule.IsEnabled));

            rule.SetSavedEnabled(rule.IsEnabled);
            await RefreshRulesAndCategoryViewsAsync(rule.IsEnabled ? "Rule enabled." : "Rule disabled.", rule.RuleId);
        }
        catch (Exception exception)
        {
            rule.IsEnabled = originalValue;
            rule.Fail(exception.Message);
        }
    }

    private Task RequestRuleDelete(RuleRowState rule)
    {
        if (rule.IsEditing)
        {
            rule.Fail("Save or cancel the current edit before deleting the rule.");
            return Task.CompletedTask;
        }

        _pendingRuleDelete = rule;
        _ruleDeleteErrorMessage = null;
        return Task.CompletedTask;
    }

