@page "/"
@inject DashboardClient DashboardClient

<PageTitle>Dashboard - XtreamForge</PageTitle>

<h1>Dashboard</h1>
<p class="page-subtitle">Operational status for the XtreamForge administration application.</p>

@if (_isLoading)
{
    <FluentCard Class="status-card loading-card">
        <FluentProgressRing />
        <span>Loading dashboard…</span>
    </FluentCard>
}
else if (_status is null)
{
    <FluentCard Class="status-card">
        <FluentMessageBar Title="Unable to load dashboard" Intent="@MessageIntent.Error" AllowDismiss="false">
            Try again after the backend and database are available.
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div>@_errorMessage</div>
            }
        </FluentMessageBar>
    </FluentCard>
}
else
{
    <div class="dashboard-grid">
        <FluentCard Class="status-card">
            <FluentLabel Typo="Typography.PaneHeader">Application status</FluentLabel>
            <div class="status-row">
                <FluentBadge Appearance="Appearance.Accent">@_status.Status</FluentBadge>
            </div>
            <p>@_status.ApplicationName v@_status.ApplicationVersion</p>
        </FluentCard>

        <FluentCard Class="status-card">
            <FluentLabel Typo="Typography.PaneHeader">Database connectivity</FluentLabel>
            <div class="status-row">
                <FluentBadge Appearance="Appearance.Neutral">@_status.DatabaseStatus</FluentBadge>
            </div>
            <p>@_status.DatabaseDetails</p>
        </FluentCard>
    </div>
}

@code {
    private DashboardStatus? _status;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await DashboardClient.GetStatusAsync();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
