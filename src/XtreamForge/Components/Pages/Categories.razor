@page "/categories"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@inject XtreamCategoryMappingService CategoryMappingService
@inject CategoryRuleService CategoryRuleService
@inject NavigationManager NavigationManager

<PageTitle>Categories - XtreamForge</PageTitle>

<h1>Categories</h1>
<p class="page-subtitle">Manage source-specific upstream categories, global custom categories, and source-scoped category rules.</p>

@if (_isLoading)
{
    <section class="status-card">
        <p>Loading categories…</p>
    </section>
}
else if (_categoryView is null || _rulesView is null)
{
    <section class="status-card validation-card">
        <p>Unable to load category administration.</p>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <p>@_errorMessage</p>
        }
    </section>
}
else if (_categoryView.Sources.Count == 0)
{
    <section class="status-card">
        <h2>No sources discovered yet</h2>
        <p>Xtream sources are created automatically the first time XtreamForge refreshes categories from an upstream provider.</p>
    </section>
}
else
{
    <form class="filters-panel" @onsubmit:preventDefault>
        <label>
            Source
            <InputSelect @bind-Value="_selectedSourceId" @bind-Value:after="OnSourceChangedAsync">
                @foreach (var source in _categoryView.Sources)
                {
                    <option value="@source.Id">@source.Protocol://@source.Host:@source.Port</option>
                }
            </InputSelect>
        </label>

        <label>
            Content type
            <InputSelect @bind-Value="_selectedContentType" @bind-Value:after="OnContentTypeChangedAsync">
                <option value="@ContentType.Vod">VOD</option>
                <option value="@ContentType.Series">Series</option>
            </InputSelect>
        </label>

        <label>
            Search
            <input @bind="_searchText" @bind:event="oninput" type="search" placeholder="Search categories" />
        </label>

        <label>
            Status
            <InputSelect @bind-Value="_statusFilter">
                <option value="@CategoryStatusFilter.All">All</option>
                <option value="@CategoryStatusFilter.Enabled">Enabled</option>
                <option value="@CategoryStatusFilter.Disabled">Disabled</option>
            </InputSelect>
        </label>
    </form>

    @if (!string.IsNullOrWhiteSpace(_statusMessage) || !string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="status-card validation-card">
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p>@_statusMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p>@_errorMessage</p>
            }
        </section>
    }

    <section class="status-card category-table-card">
        <h2>Source categories</h2>
        <p class="category-meta">Manual Disabled overrides rules. Otherwise the first enabled matching rule wins, then the active mapping decides whether the category stays Original or uses a global Custom Category.</p>

        @if (FilteredCategoryRows.Count == 0)
        {
            <p>No categories match the current filter.</p>
        }
        else
        {
            <table class="category-table">
                <thead>
                    <tr>
                        <th>Upstream category</th>
                        <th>Mapping</th>
                        <th>Status</th>
                        <th>Rule</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredCategoryRows)
                    {
                        var statusCssClass = row.Summary.EffectiveDecision == CategoryInclusionDecision.Include ? "category-pill-include" : "category-pill-exclude";

                        <tr>
                            <td>
                                <div><strong>@row.Summary.UpstreamCategoryName</strong></div>
                                <div class="category-meta">Upstream ID: @row.Summary.UpstreamCategoryId · Original output: @row.Summary.DedicatedXtreamForgeCategoryId</div>
                            </td>
                            <td>
                                <InputSelect @bind-Value="row.MappingValue" @bind-Value:after="() => OnMappingSelectionChangedAsync(row)" disabled="@(_busyCategoryId == row.Summary.Id)">
                                    <option value="disabled">Disabled</option>
                                    <option value="original">@row.Summary.UpstreamCategoryName</option>
                                    <option value="new">New category</option>
                                    @foreach (var customCategory in _customCategoryRows)
                                    {
                                        <option value="@CategoryRowState.GetCustomMappingValue(customCategory.Summary.Id)">@customCategory.Summary.DisplayName</option>
                                    }
                                </InputSelect>

                                @if (row.IsCreatingCustomCategory)
                                {
                                    <div class="inline-editor-row">
                                        <InputText @bind-Value="row.NewCustomCategoryName" maxlength="255" placeholder="New category name" disabled="@(_busyCategoryId == row.Summary.Id)" />
                                        <button type="button" @onclick="async () => await CreateCustomCategoryAsync(row)" disabled="@(_busyCategoryId == row.Summary.Id)">Create</button>
                                        <button type="button" @onclick="() => CancelCustomCategoryCreate(row)" disabled="@(_busyCategoryId == row.Summary.Id)">Cancel</button>
                                    </div>
                                }

                                @if (_busyCategoryId == row.Summary.Id)
                                {
                                    <div class="category-meta">Saving…</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.Message))
                                {
                                    <div class="category-meta">@row.Message</div>
                                }
                            </td>
                            <td>
                                @if (row.Summary.IsManuallyExcluded)
                                {
                                    <span class="category-pill category-pill-exclude">Disabled (manual)</span>
                                }
                                else
                                {
                                    <span class="category-pill @statusCssClass">@row.Summary.EffectiveDecision</span>
                                }
                            </td>
                            <td>
                                @if (row.Summary.MatchedRuleId is int matchedRuleId && row.Summary.MatchedRuleSequence is int matchedRuleSequence)
                                {
                                    <a href="#rule-@matchedRuleId">#@matchedRuleSequence @row.Summary.MatchedRuleAction · @row.Summary.MatchedRuleOperator "@row.Summary.MatchedPattern"</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="status-card category-rules-card">
        <h2>Category rules</h2>
        <p class="category-meta">Rules are scoped to the selected source and content type. Disabled rules are skipped. Delete removes the rule from PostgreSQL and the evaluator.</p>

        <div class="rule-editor-grid">
            <label>
                Action
                <InputSelect @bind-Value="_newRule.Action" disabled="@_isRuleCreating">
                    <option value="@CategoryRuleAction.Include">Include</option>
                    <option value="@CategoryRuleAction.Exclude">Exclude</option>
                </InputSelect>
            </label>

            <label>
                Operator
                <InputSelect @bind-Value="_newRule.Operator" disabled="@_isRuleCreating">
                    <option value="@CategoryRuleOperator.Contains">Contains</option>
                    <option value="@CategoryRuleOperator.StartsWith">StartsWith</option>
                </InputSelect>
            </label>

            <label>
                Pattern
                <InputText @bind-Value="_newRule.Pattern" maxlength="255" disabled="@_isRuleCreating" />
            </label>

            <label class="checkbox-label">
                <InputCheckbox @bind-Value="_newRule.CaseSensitive" disabled="@_isRuleCreating" />
                Case sensitive
            </label>

            <label class="checkbox-label">
                <InputCheckbox @bind-Value="_newRule.IsEnabled" disabled="@_isRuleCreating" />
                Enabled
            </label>

            <button type="button" @onclick="CreateRuleAsync" disabled="@_isRuleCreating">@(_isRuleCreating ? "Saving…" : "Add rule")</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_ruleMessage) || !string.IsNullOrWhiteSpace(_ruleErrorMessage))
        {
            <div class="category-meta">
                @if (!string.IsNullOrWhiteSpace(_ruleMessage))
                {
                    <div>@_ruleMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_ruleErrorMessage))
                {
                    <div>@_ruleErrorMessage</div>
                }
            </div>
        }

        @if (_ruleRows.Count == 0)
        {
            <p>No rules configured for this source and content type.</p>
        }
        else
        {
            <table class="category-table rules-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Action</th>
                        <th>Operator</th>
                        <th>Pattern</th>
                        <th>Case sensitive</th>
                        <th>Enabled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in _ruleRows)
                    {
                        <tr id="rule-@rule.RuleId">
                            <td>@rule.Sequence</td>
                            <td>
                                <InputSelect @bind-Value="rule.Action" disabled="@(_busyRuleId == rule.RuleId)">
                                    <option value="@CategoryRuleAction.Include">Include</option>
                                    <option value="@CategoryRuleAction.Exclude">Exclude</option>
                                </InputSelect>
                            </td>
                            <td>
                                <InputSelect @bind-Value="rule.Operator" disabled="@(_busyRuleId == rule.RuleId)">
                                    <option value="@CategoryRuleOperator.Contains">Contains</option>
                                    <option value="@CategoryRuleOperator.StartsWith">StartsWith</option>
                                </InputSelect>
                            </td>
                            <td><InputText @bind-Value="rule.Pattern" maxlength="255" disabled="@(_busyRuleId == rule.RuleId)" /></td>
                            <td><InputCheckbox @bind-Value="rule.CaseSensitive" disabled="@(_busyRuleId == rule.RuleId)" /></td>
                            <td><InputCheckbox @bind-Value="rule.IsEnabled" disabled="@(_busyRuleId == rule.RuleId)" /></td>
                            <td>
                                <div class="inline-editor-row">
                                    <button type="button" @onclick="async () => await MoveRuleAsync(rule, CategoryRuleMoveDirection.Up)" disabled="@(_busyRuleId == rule.RuleId)">↑</button>
                                    <button type="button" @onclick="async () => await MoveRuleAsync(rule, CategoryRuleMoveDirection.Down)" disabled="@(_busyRuleId == rule.RuleId)">↓</button>
                                    <button type="button" @onclick="async () => await SaveRuleAsync(rule)" disabled="@(_busyRuleId == rule.RuleId)">@(_busyRuleId == rule.RuleId ? "Saving…" : "Save")</button>
                                </div>
                                <div class="inline-editor-row compact-rule-actions">
                                    <label class="checkbox-label compact-checkbox-label">
                                        <InputCheckbox @bind-Value="rule.ConfirmDelete" disabled="@(_busyRuleId == rule.RuleId)" />
                                        Confirm delete
                                    </label>
                                    <button type="button" @onclick="async () => await DeleteRuleAsync(rule)" disabled="@(_busyRuleId == rule.RuleId)">Delete</button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rule.Message))
                                {
                                    <div class="category-meta">@rule.Message</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="status-card category-summary-card">
        <h2>Global custom categories</h2>
        <p class="category-meta">Custom categories are shared across all sources for the selected content type.</p>

        <div class="inline-editor-row">
            <InputText @bind-Value="_newCustomCategory.DisplayName" maxlength="255" placeholder="New custom category name" disabled="@_isCustomCategoryCreating" />
            <button type="button" @onclick="CreateStandaloneCustomCategoryAsync" disabled="@_isCustomCategoryCreating">@(_isCustomCategoryCreating ? "Saving…" : "Create")</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_customCategoryMessage) || !string.IsNullOrWhiteSpace(_customCategoryErrorMessage))
        {
            <div class="category-meta">
                @if (!string.IsNullOrWhiteSpace(_customCategoryMessage))
                {
                    <div>@_customCategoryMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(_customCategoryErrorMessage))
                {
                    <div>@_customCategoryErrorMessage</div>
                }
            </div>
        }

        @if (_customCategoryRows.Count == 0)
        {
            <p>No custom categories created for this content type yet.</p>
        }
        else
        {
            <table class="category-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Usage</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customCategory in _customCategoryRows)
                    {
                        <tr>
                            <td>@customCategory.Summary.XtreamForgeCategoryId</td>
                            <td><InputText @bind-Value="customCategory.DisplayName" maxlength="255" disabled="@(_busyCustomCategoryId == customCategory.Summary.Id)" /></td>
                            <td>@customCategory.Summary.UsageCount mapping(s)</td>
                            <td>
                                <div class="inline-editor-row">
                                    <button type="button" @onclick="async () => await SaveCustomCategoryAsync(customCategory)" disabled="@(_busyCustomCategoryId == customCategory.Summary.Id)">@(_busyCustomCategoryId == customCategory.Summary.Id ? "Saving…" : "Save")</button>
                                    <button type="button" @onclick="async () => await DeleteCustomCategoryAsync(customCategory)" disabled="@(_busyCustomCategoryId == customCategory.Summary.Id || customCategory.Summary.UsageCount > 0)">Delete</button>
                                </div>
                                @if (customCategory.Summary.UsageCount > 0)
                                {
                                    <div class="category-meta">In use by @customCategory.Summary.UsageCount mapping(s).</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private CategoryAdministrationView? _categoryView;
    private CategoryRulesAdministrationView? _rulesView;
    private List<CategoryRowState> _categoryRows = [];
    private List<RuleRowState> _ruleRows = [];
    private List<CustomCategoryRowState> _customCategoryRows = [];
    private RuleEditorState _newRule = new();
    private CustomCategoryEditorState _newCustomCategory = new();
    private bool _isLoading = true;
    private int? _selectedSourceId;
    private ContentType _selectedContentType = ContentType.Vod;
    private string _searchText = string.Empty;
    private CategoryStatusFilter _statusFilter = CategoryStatusFilter.All;
    private int? _busyCategoryId;
    private int? _busyRuleId;
    private int? _busyCustomCategoryId;
    private bool _isRuleCreating;
    private bool _isCustomCategoryCreating;
    private string? _statusMessage;
    private string? _errorMessage;
    private string? _ruleMessage;
    private string? _ruleErrorMessage;
    private string? _customCategoryMessage;
    private string? _customCategoryErrorMessage;

    private IReadOnlyList<CategoryRowState> FilteredCategoryRows => CategoriesAdminState.FilterCategoryRows(_categoryRows, _searchText, _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryString();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        _errorMessage = null;
        _ruleMessage = null;
        _ruleErrorMessage = null;
        _customCategoryMessage = null;
        _customCategoryErrorMessage = null;
        StateHasChanged();

        try
        {
            _categoryView = await CategoryMappingService.GetAdministrationViewAsync(_selectedSourceId, _selectedContentType);
            _selectedSourceId = _categoryView.SelectedSourceId;
            _rulesView = _selectedSourceId is int sourceId
                ? await CategoryRuleService.GetAdministrationViewAsync(sourceId, _selectedContentType, null)
                : new CategoryRulesAdministrationView([], null, null);

            _categoryRows = _categoryView.UpstreamCategories.Select(summary => new CategoryRowState(summary)).ToList();
            _ruleRows = _rulesView.Rules.Select(summary => new RuleRowState(summary)).ToList();
            _customCategoryRows = _categoryView.CustomCategories.Select(summary => new CustomCategoryRowState(summary)).ToList();
            _newRule = new RuleEditorState { IsEnabled = true };
            _newCustomCategory = new CustomCategoryEditorState();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("sourceId", out var sourceValues)
            && int.TryParse(sourceValues[0], NumberStyles.None, CultureInfo.InvariantCulture, out var parsedSourceId))
        {
            _selectedSourceId = parsedSourceId;
        }

        if (query.TryGetValue("contentType", out var contentTypeValues)
            && Enum.TryParse<ContentType>(contentTypeValues[0], true, out var parsedContentType))
        {
            _selectedContentType = parsedContentType;
        }
    }

    private async Task OnSourceChangedAsync()
    {
        if (_selectedSourceId is not null)
        {
            await ReloadAsync();
        }
    }

    private async Task OnContentTypeChangedAsync()
    {
        await ReloadAsync();
    }

    private async Task OnMappingSelectionChangedAsync(CategoryRowState row)
    {
        row.Message = null;
        _statusMessage = null;
        _errorMessage = null;

        if (row.MappingValue == "new")
        {
            row.BeginCustomCategoryCreate();
            return;
        }

        await SaveCategoryMappingAsync(row, row.MappingValue, null);
    }

    private void CancelCustomCategoryCreate(CategoryRowState row) =>
        row.CancelCustomCategoryCreate();

    private async Task CreateCustomCategoryAsync(CategoryRowState row)
    {
        row.Message = null;
        _statusMessage = null;
        _errorMessage = null;
        await SaveCategoryMappingAsync(row, "new", row.NewCustomCategoryName);
    }

    private async Task SaveCategoryMappingAsync(CategoryRowState row, string mappingValue, string? newCustomCategoryName)
    {
        if (_selectedSourceId is null)
        {
            _errorMessage = "A source must be selected.";
            return;
        }

        try
        {
            _busyCategoryId = row.Summary.Id;
            var command = mappingValue switch
            {
                "disabled" => new CategoryConfigurationCommand(row.Summary.Id, _selectedSourceId.Value, _selectedContentType, CategoryMappingSelection.Disabled, null, null),
                "original" => new CategoryConfigurationCommand(row.Summary.Id, _selectedSourceId.Value, _selectedContentType, CategoryMappingSelection.Original, null, null),
                "new" => new CategoryConfigurationCommand(row.Summary.Id, _selectedSourceId.Value, _selectedContentType, CategoryMappingSelection.Custom, null, newCustomCategoryName),
                _ when mappingValue.StartsWith("custom:", StringComparison.Ordinal) && int.TryParse(mappingValue[7..], NumberStyles.None, CultureInfo.InvariantCulture, out var customCategoryId)
                    => new CategoryConfigurationCommand(row.Summary.Id, _selectedSourceId.Value, _selectedContentType, CategoryMappingSelection.Custom, customCategoryId, null),
                _ => throw new InvalidOperationException("Invalid category mapping selection.")
            };

            await CategoryMappingService.SaveCategoryConfigurationAsync(command);
            row.CommitMapping(mappingValue switch
            {
                "new" when !string.IsNullOrWhiteSpace(newCustomCategoryName) => row.MappingValue,
                _ => mappingValue
            });
            _statusMessage = "Saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            row.Message = exception.Message;
            _errorMessage = exception.Message;
        }
        finally
        {
            _busyCategoryId = null;
        }
    }

    private async Task CreateRuleAsync()
    {
        if (_selectedSourceId is null)
        {
            _ruleErrorMessage = "A source must be selected.";
            return;
        }

        try
        {
            _isRuleCreating = true;
            _ruleMessage = null;
            _ruleErrorMessage = null;
            await CategoryRuleService.CreateRuleAsync(new CategoryRuleEditorCommand(
                null,
                _selectedSourceId.Value,
                _selectedContentType,
                _newRule.Action,
                _newRule.Operator,
                _newRule.Pattern,
                _newRule.CaseSensitive,
                _newRule.IsEnabled));

            _ruleMessage = "Rule saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _isRuleCreating = false;
        }
    }

    private async Task SaveRuleAsync(RuleRowState rule)
    {
        if (_selectedSourceId is null)
        {
            _ruleErrorMessage = "A source must be selected.";
            return;
        }

        try
        {
            _busyRuleId = rule.RuleId;
            _ruleMessage = null;
            _ruleErrorMessage = null;
            rule.Message = null;
            await CategoryRuleService.UpdateRuleAsync(new CategoryRuleEditorCommand(
                rule.RuleId,
                _selectedSourceId.Value,
                _selectedContentType,
                rule.Action,
                rule.Operator,
                rule.Pattern,
                rule.CaseSensitive,
                rule.IsEnabled));

            _ruleMessage = "Rule saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            rule.Message = exception.Message;
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _busyRuleId = null;
        }
    }

    private async Task MoveRuleAsync(RuleRowState rule, CategoryRuleMoveDirection direction)
    {
        if (_selectedSourceId is null)
        {
            _ruleErrorMessage = "A source must be selected.";
            return;
        }

        try
        {
            _busyRuleId = rule.RuleId;
            _ruleMessage = null;
            _ruleErrorMessage = null;
            await CategoryRuleService.MoveRuleAsync(new CategoryRuleIdentityCommand(rule.RuleId, _selectedSourceId.Value, _selectedContentType), direction);
            _ruleMessage = "Rule order updated.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            rule.Message = exception.Message;
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _busyRuleId = null;
        }
    }

    private async Task DeleteRuleAsync(RuleRowState rule)
    {
        if (_selectedSourceId is null)
        {
            _ruleErrorMessage = "A source must be selected.";
            return;
        }

        if (!rule.ConfirmDelete)
        {
            rule.Message = "Confirm delete before removing a rule.";
            return;
        }

        try
        {
            _busyRuleId = rule.RuleId;
            _ruleMessage = null;
            _ruleErrorMessage = null;
            await CategoryRuleService.DeleteRuleAsync(new CategoryRuleDeleteCommand(rule.RuleId, _selectedSourceId.Value, _selectedContentType, true));
            _ruleMessage = "Rule deleted.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            rule.Message = exception.Message;
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _busyRuleId = null;
        }
    }

    private async Task SaveCustomCategoryAsync(CustomCategoryRowState row)
    {
        try
        {
            _busyCustomCategoryId = row.Summary.Id;
            _customCategoryMessage = null;
            _customCategoryErrorMessage = null;
            await CategoryMappingService.UpdateCustomCategoryAsync(new CustomCategoryUpdateCommand(row.Summary.Id, _selectedContentType, row.DisplayName));
            _customCategoryMessage = "Custom category saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _customCategoryErrorMessage = exception.Message;
        }
        finally
        {
            _busyCustomCategoryId = null;
        }
    }

    private async Task CreateStandaloneCustomCategoryAsync()
    {
        try
        {
            _isCustomCategoryCreating = true;
            _customCategoryMessage = null;
            _customCategoryErrorMessage = null;
            await CategoryMappingService.CreateCustomCategoryAsync(new CustomCategoryCreateCommand(_selectedContentType, _newCustomCategory.DisplayName));
            _customCategoryMessage = "Custom category created.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _customCategoryErrorMessage = exception.Message;
        }
        finally
        {
            _isCustomCategoryCreating = false;
        }
    }

    private async Task DeleteCustomCategoryAsync(CustomCategoryRowState row)
    {
        try
        {
            _busyCustomCategoryId = row.Summary.Id;
            _customCategoryMessage = null;
            _customCategoryErrorMessage = null;
            await CategoryMappingService.DeleteCustomCategoryAsync(new CustomCategoryDeleteCommand(row.Summary.Id, _selectedContentType));
            _customCategoryMessage = "Custom category deleted.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _customCategoryErrorMessage = exception.Message;
        }
        finally
        {
            _busyCustomCategoryId = null;
        }
    }

}
