@namespace XtreamForge.Blazor.Features.Categories.CustomCategories

<section class="categories-tab-panel">
    <header class="categories-panel-header">
        <div>
            <h2>Global Custom Categories</h2>
            <p class="category-meta">Custom categories are shared across sources for the selected content type and keep stable XtreamForge IDs.</p>
        </div>
        @if (IsRefreshing)
        {
            <FluentProgressRing Width="20px" />
        }
    </header>

    <div class="categories-toolbar-grid">
        <FluentSelect TOption="string" Value="@SelectedContentType.ToString()" ValueChanged="HandleContentTypeChangedAsync" Label="Content Type">
            <FluentOption Value="@AdminContentType.Vod.ToString()">VOD</FluentOption>
            <FluentOption Value="@AdminContentType.Series.ToString()">Series</FluentOption>
        </FluentSelect>

        <div class="toolbar-actions">
            <FluentButton Appearance="Appearance.Accent" @onclick="() => OnOpenCreate.InvokeAsync()">
                <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Slot="start" />
                <span>New Category</span>
            </FluentButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <FluentMessageBar Title="Custom categories" Intent="@MessageIntent.Success" AllowDismiss="false">@Message</FluentMessageBar>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <FluentMessageBar Title="Custom categories" Intent="@MessageIntent.Error" AllowDismiss="false">@ErrorMessage</FluentMessageBar>
    }

    @if (Rows.Count == 0)
    {
        <FluentCard Class="empty-state">
            <p>No custom categories created for this content type yet.</p>
        </FluentCard>
    }
    else
    {
        <div class="table-scroll">
            <FluentDataGrid Items="@Rows.AsQueryable()"
                            TGridItem="CustomCategoryRowState"
                            DisplayMode="DataGridDisplayMode.Table"
                            GridTemplateColumns="2fr 1.2fr 1fr"
                            RowSize="DataGridRowSize.Small"
                            MultiLine="true"
                            Class="categories-grid">
                <TemplateColumn Title="Name">
                    <div class="category-name">@context.Summary.DisplayName</div>
                    <div class="category-meta">XtreamForge ID @context.Summary.XtreamForgeCategoryId</div>
                    @if (!string.IsNullOrWhiteSpace(context.Message))
                    {
                        <div class="category-meta">@context.Message</div>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Used By">
                    @if (context.UsageCount > 0)
                    {
                        <div class="usage-cell">
                            <FluentButton Appearance="Appearance.Stealth" @onclick="() => OnOpenUsages.InvokeAsync(context)">
                                @context.UsageCount source categor@(context.UsageCount == 1 ? "y" : "ies")
                            </FluentButton>
                        </div>
                    }
                    else
                    {
                        <span class="category-meta">Unused</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <div class="row-actions">
                        @if (!context.IsEditing)
                        {
                            <FluentButton Appearance="Appearance.Neutral" Title="Edit custom category" AriaLabel="Edit custom category" @onclick="() => OnBeginEdit.InvokeAsync(context)" Disabled="@context.IsBusy">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" />
                            </FluentButton>
                        }
                        <FluentButton Appearance="Appearance.Neutral"
                                      Title="@(context.UsageCount > 0 ? "Delete unavailable while category is in use" : "Delete custom category")"
                                      AriaLabel="Delete custom category"
                                      @onclick="() => OnRequestDelete.InvokeAsync(context)"
                                      Disabled="@(context.IsBusy || context.UsageCount > 0)">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Color.Error" />
                        </FluentButton>
                    </div>
                    @if (context.IsEditing)
                    {
                        <div class="inline-editor-box">
                            <FluentTextField @bind-Value="context.DisplayName" Maxlength="255" Label="Name" Disabled="@context.IsBusy" />
                            <div class="inline-editor-actions">
                                <FluentButton Appearance="Appearance.Accent" @onclick="() => OnSave.InvokeAsync(context)" Disabled="@context.IsBusy">Save</FluentButton>
                                <FluentButton Appearance="Appearance.Neutral" @onclick="() => OnCancelEdit.InvokeAsync(context)" Disabled="@context.IsBusy">Cancel</FluentButton>
                            </div>
                        </div>
                    }
                    @if (context.UsageCount > 0)
                    {
                        <div class="category-meta">Delete is available only when unused. Inspect Used By for details.</div>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</section>

@code {
    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public required IReadOnlyList<CustomCategoryRowState> Rows { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnOpenCreate { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnBeginEdit { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnCancelEdit { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnSave { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnOpenUsages { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnRequestDelete { get; set; }

    private Task HandleContentTypeChangedAsync(string? value) =>
        Enum.TryParse<AdminContentType>(value, true, out var contentType)
            ? OnContentTypeChanged.InvokeAsync(contentType)
            : Task.CompletedTask;
}
