@namespace XtreamForge.Blazor.Features.Categories.CategoryRules
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="categories-tab-panel">
    <header class="section-header">
        <div class="section-heading">
            <div class="section-title-row">
                <h2>Category Rules</h2>
                <span class="section-count">@Rows.Count rule@(Rows.Count == 1 ? string.Empty : "s")</span>
            </div>
            <p class="section-description">Manage ordered include and exclude rules for the selected source.</p>
            <div class="section-help">
                <FluentIcon Value="@(new Icons.Regular.Size16.Info())" />
                <span>Rules are evaluated in sequence. The first enabled match wins.</span>
            </div>
        </div>
        @if (IsRefreshing)
        {
            <FluentProgressRing Width="20px" />
        }
    </header>

    <div class="category-toolbar rules-toolbar">
        <div class="toolbar-field toolbar-field-source">
            <FluentSelect TOption="string" Value="@FormatNullableInt(SelectedSourceId)" ValueChanged="HandleSourceChangedAsync" Disabled="@(Sources.Count == 0)" Label="Source">
                @if (Sources.Count == 0)
                {
                    <FluentOption Value="">No sources</FluentOption>
                }
                else
                {
                    @foreach (var source in Sources)
                    {
                        <FluentOption Value="@source.Id.ToString(CultureInfo.InvariantCulture)">@FormatSourceDisplayName(source.DisplayName)</FluentOption>
                    }
                }
            </FluentSelect>
        </div>

        <div class="toolbar-field toolbar-field-content-type">
            <FluentSelect TOption="string" Value="@SelectedContentType.ToString()" ValueChanged="HandleContentTypeChangedAsync" Label="Content Type">
                <FluentOption Value="@AdminContentType.Vod.ToString()">VOD</FluentOption>
                <FluentOption Value="@AdminContentType.Series.ToString()">Series</FluentOption>
            </FluentSelect>
        </div>

        <div class="toolbar-field toolbar-field-action">
            <FluentButton Class="primary-action-button" Appearance="Appearance.Accent" @onclick="() => OnOpenCreate.InvokeAsync()" Disabled="@(!HasSelectedSource)">
                <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Slot="start" />
                <span>Add rule</span>
            </FluentButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <FluentMessageBar Title="Category rules" Intent="@MessageIntent.Success" AllowDismiss="false">@Message</FluentMessageBar>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <FluentMessageBar Title="Category rules" Intent="@MessageIntent.Error" AllowDismiss="false">@ErrorMessage</FluentMessageBar>
    }

    <section class="rule-tester-panel">
        <div class="rule-tester-header">
            <h3>Rule Tester</h3>
            <span class="section-help">Preview a category against the current ordered rules.</span>
        </div>

        <div class="rule-tester-grid">
            <FluentTextField Class="rule-tester-input" @bind-Value="Tester.CategoryName" Maxlength="255" Placeholder="|FR| DOCUMENTAIRE SPORT" Label="Category name" Disabled="@(!HasSelectedSource || Tester.IsBusy)" />
            <div class="rule-action-cell">
                <FluentButton Appearance="Appearance.Neutral" @onclick="() => OnRunTester.InvokeAsync()" Disabled="@(!HasSelectedSource || Tester.IsBusy)">
                    @(Tester.IsBusy ? "Testing…" : "Test rule")
                </FluentButton>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Tester.ErrorMessage))
        {
            <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@Tester.ErrorMessage</FluentMessageBar>
        }
        else if (Tester.Preview is not null)
        {
            <div class="rule-tester-result">
                <div class="rule-tester-result-primary">
                    <span class="@(Tester.Preview.Decision == "Exclude" ? "status-pill status-pill-manual" : "status-pill status-pill-enabled")">
                        <span class="status-dot"></span>
                        <span>@GetRuleTesterSummary(Tester.Preview)</span>
                    </span>
                </div>
                <div class="rule-secondary">@GetRuleTesterDetails(Tester.Preview)</div>
            </div>
        }
    </section>

    @if (!HasSelectedSource)
    {
        <FluentCard Class="empty-state">
            <p>Select a source to manage rules.</p>
        </FluentCard>
    }
    else if (Rows.Count == 0)
    {
        <FluentCard Class="empty-state">
            <p>No rules configured for this source and content type.</p>
        </FluentCard>
    }
    else
    {
        <div class="table-scroll">
            <table class="category-grid rules-grid" @ref="_rulesTable">
                <colgroup>
                    <col class="rules-drag-column" />
                    <col class="rules-sequence-column" />
                    <col class="rules-action-column" />
                    <col class="rules-match-column" />
                    <col class="rules-pattern-column" />
                    <col class="rules-case-column" />
                    <col class="rules-enabled-column" />
                    <col class="rules-actions-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="drag-column"></th>
                        <th>#</th>
                        <th>Action</th>
                        <th>Match</th>
                        <th>Pattern</th>
                        <th>Case</th>
                        <th>Enabled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Rows.Count; index++)
                    {
                        var rule = Rows[index];
                        <tr @key="rule.RuleId"
                            class="@GetRowClass(rule)"
                            data-rule-id="@rule.RuleId"
                            data-drop-index="@index">
                            <td class="drag-column">
                                <FluentButton Appearance="Appearance.Stealth"
                                              Class="drag-handle compact-icon-button"
                                              Title="Drag to reorder"
                                              AriaLabel="Drag to reorder"
                                              data-drag-handle="true"
                                              Disabled="@(!rule.CanRunSecondaryActions || rule.IsEditing)">
                                    ⋮⋮
                                </FluentButton>
                            </td>
                            <td class="rule-sequence-cell">@rule.Sequence</td>
                            @if (rule.IsEditing)
                            {
                                <td class="rule-edit-cell">
                                    <FluentSelect Class="inline-edit-field" TOption="string" Value="@rule.Action.ToString()" ValueChanged="value => rule.Action = ParseAction(value)" Disabled="@rule.IsBusy" AriaLabel="Rule action">
                                        <FluentOption Value="@CategoryRuleActionOption.Include.ToString()">Include</FluentOption>
                                        <FluentOption Value="@CategoryRuleActionOption.Exclude.ToString()">Exclude</FluentOption>
                                    </FluentSelect>
                                </td>
                                <td class="rule-edit-cell">
                                    <FluentSelect Class="inline-edit-field" TOption="string" Value="@rule.Operator.ToString()" ValueChanged="value => rule.Operator = ParseOperator(value)" Disabled="@rule.IsBusy" AriaLabel="Rule match operator">
                                        <FluentOption Value="@CategoryRuleOperatorOption.Contains.ToString()">Contains</FluentOption>
                                        <FluentOption Value="@CategoryRuleOperatorOption.StartsWith.ToString()">StartsWith</FluentOption>
                                    </FluentSelect>
                                </td>
                                <td class="rule-edit-cell">
                                    <FluentTextField Class="inline-edit-field" @bind-Value="rule.Pattern" Maxlength="255" Disabled="@rule.IsBusy" AriaLabel="Rule pattern" />
                                </td>
                                <td class="rule-edit-cell">
                                    <FluentCheckbox Class="inline-edit-checkbox" @bind-Value="rule.CaseSensitive" Disabled="@rule.IsBusy">Case sensitive</FluentCheckbox>
                                </td>
                                <td class="rule-edit-cell">
                                    <FluentSwitch @bind-Value="rule.IsEnabled" Disabled="@rule.IsBusy" CheckedMessage="On" UncheckedMessage="Off">Enabled</FluentSwitch>
                                </td>
                            }
                            else
                            {
                                <td class="nowrap-cell">@rule.Action</td>
                                <td class="nowrap-cell">@rule.Operator</td>
                                <td class="rule-pattern-cell">@rule.Pattern</td>
                                <td class="nowrap-cell">@(rule.CaseSensitive ? "Case sensitive" : "Ignore case")</td>
                                <td>
                                    <FluentSwitch Value="@rule.IsEnabled" ValueChanged="value => OnToggleEnabled.InvokeAsync(new RuleToggleRequest(rule, value))" Disabled="@rule.IsBusy" CheckedMessage="On" UncheckedMessage="Off" AriaLabel="Toggle rule enabled state" />
                                </td>
                            }
                            <td class="rule-actions-cell">
                                <div class="row-actions @(rule.IsEditing ? "inline-edit-actions" : string.Empty)">
                                    @if (rule.IsEditing)
                                    {
                                        <FluentButton Appearance="Appearance.Accent" @onclick="() => OnSave.InvokeAsync(rule)" Disabled="@rule.IsBusy">@(rule.IsBusy ? "Saving…" : "Save")</FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral" @onclick="() => OnCancelEdit.InvokeAsync(rule)" Disabled="@rule.IsBusy">Cancel</FluentButton>
                                    }
                                    else
                                    {
                                        <FluentButton Appearance="Appearance.Neutral" Class="compact-icon-button" Title="Edit rule" AriaLabel="Edit rule" @onclick="() => OnBeginEdit.InvokeAsync(rule)" Disabled="@rule.IsBusy">
                                            <FluentIcon Value="@(new Icons.Regular.Size20.Edit())" />
                                        </FluentButton>
                                        <FluentButton Appearance="Appearance.Neutral"
                                                      Class="compact-icon-button"
                                                      Title="Delete rule"
                                                      AriaLabel="Delete rule"
                                                      @onclick="() => OnRequestDelete.InvokeAsync(rule)"
                                                      Disabled="@(!rule.CanRunSecondaryActions)">
                                            <FluentIcon Value="@(new Icons.Regular.Size20.Delete())" Color="Color.Error" />
                                        </FluentButton>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rule.Message))
                                {
                                    <div class="@(rule.SaveState == MutationFeedbackState.Failed ? "inline-error" : "category-meta")">@rule.Message</div>
                                }
                            </td>
                        </tr>
                    }

                    <tr class="rule-drop-zone" data-drop-index="@Rows.Count">
                        <td colspan="8">
                            <div class="rule-drop-indicator"></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private ElementReference _rulesTable;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CategoryRulesTab>? _dotNetReference;
    private string? _lastDragDropSignature;

    [Parameter]
    public required IReadOnlyList<AdminSource> Sources { get; set; }

    [Parameter]
    public int? SelectedSourceId { get; set; }

    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public required IReadOnlyList<RuleRowState> Rows { get; set; }

    [Parameter]
    public required RuleTesterState Tester { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public int? HighlightedRuleId { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnOpenCreate { get; set; }

    [Parameter]
    public EventCallback OnRunTester { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnBeginEdit { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnCancelEdit { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnSave { get; set; }

    [Parameter]
    public EventCallback<RuleRowState> OnRequestDelete { get; set; }

    [Parameter]
    public EventCallback<RuleToggleRequest> OnToggleEnabled { get; set; }

    [Parameter]
    public EventCallback<int?> OnSourceChanged { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<RuleDropRequest> OnDropRequested { get; set; }

    private bool HasSelectedSource => SelectedSourceId is not null;

    private static string FormatSourceDisplayName(string displayName)
    {
        if (!Uri.TryCreate(displayName, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            return displayName;
        }

        var path = uri.AbsolutePath.TrimEnd('/');
        return string.IsNullOrEmpty(path) || path == "/"
            ? uri.Authority
            : $"{uri.Authority}{path}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HasSelectedSource || Rows.Count == 0)
        {
            return;
        }

        private static string GetRuleTesterSummary(AdminCategoryRulePreview preview)
        {
            if (preview.MatchedRuleSequence is int matchedRuleSequence)
            {
                return $"{preview.Decision} by rule #{matchedRuleSequence}";
            }

            return string.Equals(preview.Decision, "Exclude", StringComparison.OrdinalIgnoreCase)
                ? "Excluded"
                : "Included by default";
        }

        private static string GetRuleTesterDetails(AdminCategoryRulePreview preview)
        {
            if (preview.MatchedRuleSequence is not int)
            {
                return "No matching rule.";
            }

            return $"{preview.MatchedRuleOperator} \"{preview.MatchedPattern}\" · {(preview.MatchedRuleCaseSensitive == true ? "Case sensitive" : "Ignore case")}";
        }

        var signature = string.Join('|', Rows.Select(rule => $"{rule.RuleId}:{rule.Sequence}:{rule.IsEditing}:{rule.IsBusy}"));
        if (!firstRender && string.Equals(_lastDragDropSignature, signature, StringComparison.Ordinal))
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Categories/CategoryRules/CategoryRulesTab.razor.js");
        _dotNetReference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initializeRuleDragDrop", _rulesTable, _dotNetReference);
        _lastDragDropSignature = signature;
    }

    [JSInvokable]
    public Task HandleRuleDropFromJs(int draggedRuleId, int targetIndex) =>
        OnDropRequested.InvokeAsync(new RuleDropRequest(draggedRuleId, targetIndex));

    private static string FormatNullableInt(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private Task HandleSourceChangedAsync(string? value) =>
        OnSourceChanged.InvokeAsync(int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var parsedValue) ? parsedValue : null);

    private Task HandleContentTypeChangedAsync(string? value) =>
        Enum.TryParse<AdminContentType>(value, true, out var contentType)
            ? OnContentTypeChanged.InvokeAsync(contentType)
            : Task.CompletedTask;

    private static CategoryRuleActionOption ParseAction(string? value) =>
        Enum.TryParse<CategoryRuleActionOption>(value, true, out var action)
            ? action
            : CategoryRuleActionOption.Include;

    private static CategoryRuleOperatorOption ParseOperator(string? value) =>
        Enum.TryParse<CategoryRuleOperatorOption>(value, true, out var categoryRuleOperator)
            ? categoryRuleOperator
            : CategoryRuleOperatorOption.Contains;

    private string GetRowClass(RuleRowState rule)
    {
        var classes = new List<string>();

        if (HighlightedRuleId == rule.RuleId)
        {
            classes.Add("highlighted-row");
        }

        if (!rule.IsEnabled)
        {
            classes.Add("disabled-rule-row");
        }

        return string.Join(' ', classes);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeRuleDragDrop", _rulesTable);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }
}
