@page "/"
@attribute [StreamRendering]
@inject DashboardStatusService DashboardStatusService

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>
<p class="page-subtitle">Early-stage operational view for the XtreamForge foundation.</p>

@if (_status is null)
{
    <p>Loading status…</p>
}
else
{
    <div class="dashboard-grid">
        <section class="status-card">
            <h2>Application status</h2>
            <p class="status-value">@_status.Application.State</p>
            <p>@_status.Application.Details</p>
        </section>

        <section class="status-card">
            <h2>Database connectivity</h2>
            <p class="status-value">@_status.Database.State</p>
            <p>@_status.Database.Details</p>
        </section>
    </div>
}

@code {
    private DashboardStatusService.DashboardStatusModel? _status;

    protected override async Task OnInitializedAsync()
    {
        _status = await DashboardStatusService.GetDashboardStatusAsync();
    }
}
