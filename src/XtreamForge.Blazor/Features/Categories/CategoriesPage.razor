    private async Task DiscoverSourceAsync()
    {
        var didSucceed = false;
        string? successMessage = null;

        try
        {
            _isSourceDiscoverySaving = true;
            _sourceDiscoveryErrorMessage = null;
            var result = await CategoriesClient.DiscoverSourceAsync(new AdminSourceDiscoveryCreate(
                _sourceDiscoveryForm.Protocol,
                _sourceDiscoveryForm.HostOrBaseUrl,
                _sourceDiscoveryForm.Port,
                _sourceDiscoveryForm.Username,
                _sourceDiscoveryForm.Password));

            _sourceDiscoveryForm.Username = null;
            _sourceDiscoveryForm.Password = null;
            _selectedSourceId = result.SourceId;
            _activeTab = CategoriesTab.SourceCategories;
            UpdateLocation();
            await ReloadAsync();
            successMessage = $"Source imported. {result.VodCategoryCount} VOD and {result.SeriesCategoryCount} Series categories synchronized.";
            didSucceed = true;
        }
        catch (Exception exception)
        {
            _sourceDiscoveryErrorMessage = exception.Message;
        }
        finally
        {
            _isSourceDiscoverySaving = false;
            if (didSucceed)
            {
                ResetAddSourceDialogState();
                _categoryMessage = successMessage;
            }
        }
    }

    private static string FormatRuleSummary(RuleRowState rule) => $"{rule.Action} categories {rule.Operator} \"{rule.Pattern}\"";

    private sealed class SourceDiscoveryFormState
    {
        public string Protocol { get; set; } = "https";

        public string? HostOrBaseUrl { get; set; }

        public int? Port { get; set; } = 443;

        public string? Username { get; set; }

        public string? Password { get; set; }

        public static SourceDiscoveryFormState CreateDefault() => new();

        public void ApplyDefaultPortForProtocol()
        {
            Port = Protocol == "http" ? 80 : 443;
        }
    }

