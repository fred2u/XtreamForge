@page "/"
@inject DashboardClient DashboardClient

<PageTitle>Dashboard - XtreamForge</PageTitle>

<h1>Dashboard</h1>
<p class="page-subtitle">Operational status for the XtreamForge administration application.</p>

@if (_isLoading)
{
    <FluentCard Class="status-card loading-card">
        <FluentProgressRing />
        <span>Loading dashboard…</span>
    </FluentCard>
}
else if (_status is null)
{
    <FluentCard Class="status-card">
        <FluentMessageBar Title="Unable to load dashboard" Intent="@MessageIntent.Error" AllowDismiss="false">
            Try again after the backend and database are available.
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div>@_errorMessage</div>
            }
        </FluentMessageBar>
    </FluentCard>
}
else
{
    <section class="dashboard-overview">
        <div class="dashboard-metrics-grid">
            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.PlugConnected())" />
                    <span>Sources</span>
                </div>
                <div class="dashboard-metric-value">@_status.SourceCount</div>
            </FluentCard>

            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Grid())" />
                    <span>Source categories</span>
                </div>
                <div class="dashboard-metric-value">@_status.SourceCategoryCount</div>
            </FluentCard>

            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Filter())" />
                    <span>Category rules</span>
                </div>
                <div class="dashboard-metric-value">@_status.RuleCount</div>
            </FluentCard>

            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Tag())" />
                    <span>Custom categories</span>
                </div>
                <div class="dashboard-metric-value">@_status.CustomCategoryCount</div>
            </FluentCard>

            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Filter())" />
                    <span>Item rules</span>
                </div>
                <div class="dashboard-metric-value">@_status.ItemRuleCount</div>
            </FluentCard>

            <FluentCard Class="dashboard-metric-card">
                <div class="dashboard-metric-label">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Tag())" />
                    <span>Known TMDB mappings</span>
                </div>
                <div class="dashboard-metric-value">@_status.KnownTmdbMappingCount</div>
            </FluentCard>
        </div>

        <FluentCard Class="dashboard-health-card">
            <div class="dashboard-section-heading">
                <h2>System health</h2>
                <span class="section-count">Live administration summary</span>
            </div>

            <div class="dashboard-health-grid">
                <div class="dashboard-health-row">
                    <div class="dashboard-health-label">Application</div>
                    <div class="@GetStatusClass(_status.Status)">
                        <span class="status-dot"></span>
                        <span>@_status.Status</span>
                    </div>
                    <div class="dashboard-health-meta">
                        <span>@_status.ApplicationName</span>
                        <span>Version @_status.ApplicationVersion</span>
                    </div>
                </div>

                <div class="dashboard-health-row">
                    <div class="dashboard-health-label">Database</div>
                    <div class="@GetStatusClass(_status.DatabaseStatus)">
                        <span class="status-dot"></span>
                        <span>@_status.DatabaseStatus</span>
                    </div>
                    <div class="dashboard-health-meta">@_status.DatabaseDetails</div>
                </div>
            </div>
        </FluentCard>
    </section>
}

@code {
    private DashboardStatus? _status;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await DashboardClient.GetStatusAsync();
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetStatusClass(string status) =>
        string.Equals(status, "Healthy", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, "Connected", StringComparison.OrdinalIgnoreCase)
            ? "status-pill status-pill-enabled"
            : "status-pill status-pill-manual";
}
