        try
        {
            rule.IsEnabled = request.IsEnabled;
            rule.BeginSave();
            await CategoriesClient.UpdateRuleAsync(rule.RuleId, new AdminCategoryRuleUpdate(
                _selectedSourceId.Value,
                _selectedContentType.ToString(),
