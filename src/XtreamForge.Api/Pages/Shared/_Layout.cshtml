@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string GetNavigationClass(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XtreamForge</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="layout-shell">
        <aside class="sidebar">
            <div class="brand">XtreamForge</div>
            <nav class="navigation" aria-label="Primary administration navigation">
                <a asp-page="/Index" class="@GetNavigationClass("/Index")" aria-current="@(currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Dashboard</a>
                <a asp-page="/Categories/Index" class="@GetNavigationClass("/Categories/Index")" aria-current="@(currentPage.Equals("/Categories/Index", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Categories</a>
                <a asp-page="/Settings/Index" class="@GetNavigationClass("/Settings/Index")" aria-current="@(currentPage.Equals("/Settings/Index", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Settings</a>
            </nav>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
