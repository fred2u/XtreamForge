@page "/categories"
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@using XtreamForge.Blazor.Features.Categories.CategoryRules
@using XtreamForge.Blazor.Features.Categories.CustomCategories
@using XtreamForge.Blazor.Features.Categories.SourceCategories
@inject CategoriesClient CategoriesClient
@inject IToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Categories - XtreamForge</PageTitle>

<h1>Categories</h1>
<p class="page-subtitle">Manage source categories, rules, and shared categories.</p>

@if (_isLoading)
{
    <FluentCard Class="status-card loading-card categories-shell-card">
        <FluentProgressRing />
        <span>Loading category administration…</span>
    </FluentCard>
}
else if (_categoryView is null || _rulesView is null)
{
    <FluentCard Class="status-card categories-shell-card">
        <FluentMessageBar Title="Unable to load category administration" Intent="@MessageIntent.Error" AllowDismiss="false">
            Try again after the backend and database are available.
            @if (!string.IsNullOrWhiteSpace(_pageErrorMessage))
            {
                <div>@_pageErrorMessage</div>
            }
        </FluentMessageBar>
    </FluentCard>
}
else
{
    <section class="categories-page-content">
        @if (!string.IsNullOrWhiteSpace(_pageErrorMessage))
        {
            <FluentMessageBar Title="Categories" Intent="@MessageIntent.Error" AllowDismiss="false">@_pageErrorMessage</FluentMessageBar>
        }

        <FluentTabs @bind-ActiveTabId="ActiveTabId" Size="TabSize.Small" Class="categories-tabs">
            <FluentTab Id="@CategoriesTab.SourceCategories.ToString()" Label="Source Categories">
                <SourceCategoriesTab
                    Sources="_categoryView.Sources"
                    SelectedSourceId="_selectedSourceId"
                    SelectedContentType="_selectedContentType"
                    SearchText="@_searchText"
                    StatusFilter="_statusFilter"
                    Rows="FilteredCategoryRows"
                    TotalCount="_categoryRows.Count"
                    CustomCategories="_customCategoryRows"
                    Message="@_categoryMessage"
                    ErrorMessage="@_categoryErrorMessage"
                    OnSourceChanged="OnSourceChangedAsync"
                    OnContentTypeChanged="OnContentTypeChangedAsync"
                    OnSearchChanged="OnSearchChangedAsync"
                    OnStatusFilterChanged="OnStatusFilterChangedAsync"
                    OnOpenAddSource="OpenAddSourceDialog"
                    OnMappingChanged="OnMappingSelectionChangedAsync"
                    OnCreateCustomCategory="CreateCustomCategoryAsync"
                    OnCancelCustomCategory="CancelCustomCategoryCreate"
                    OnRetry="RetryCategoryMappingAsync"
                    OnOpenRule="OpenMatchedRuleAsync" />
            </FluentTab>
            <FluentTab Id="@CategoriesTab.CategoryRules.ToString()" Label="Category Rules">
                <CategoryRulesTab
                    Sources="_categoryView.Sources"
                    SelectedSourceId="_selectedSourceId"
                    SelectedContentType="_selectedContentType"
                    Rows="_ruleRows"
                    Tester="_ruleTester"
                    IsRefreshing="_isRulesRefreshing"
                    HighlightedRuleId="_highlightedRuleId"
                    Message="@_ruleMessage"
                    ErrorMessage="@_ruleErrorMessage"
                    OnSourceChanged="OnSourceChangedAsync"
                    OnContentTypeChanged="OnContentTypeChangedAsync"
                    OnOpenCreate="OpenAddRuleDialog"
                    OnRunTester="RunRuleTesterAsync"
                    OnBeginEdit="BeginRuleEdit"
                    OnCancelEdit="CancelRuleEdit"
                    OnSave="SaveRuleAsync"
                    OnRequestDelete="RequestRuleDelete"
                    OnToggleEnabled="ToggleRuleEnabledAsync"
                    OnDropRequested="DropRuleAsync" />
            </FluentTab>
            <FluentTab Id="@CategoriesTab.GlobalCustomCategories.ToString()" Label="Global Custom Categories">
                <CustomCategoriesTab
                    SelectedContentType="_selectedContentType"
                    Rows="_customCategoryRows"
                    IsRefreshing="_isCategoryDataRefreshing"
                    Message="@_customCategoryMessage"
                    ErrorMessage="@_customCategoryErrorMessage"
                    OnContentTypeChanged="OnContentTypeChangedAsync"
                    OnOpenCreate="OpenNewCustomCategoryDialog"
                    OnBeginEdit="BeginCustomCategoryEdit"
                    OnCancelEdit="CancelCustomCategoryEdit"
                    OnSave="SaveCustomCategoryAsync"
                    OnOpenUsages="OpenCustomCategoryUsagesAsync"
                    OnRequestDelete="RequestCustomCategoryDelete" />
            </FluentTab>
        </FluentTabs>
    </section>
}

@if (_isAddSourceDialogOpen)
{
    <FluentDialog Modal="true" TrapFocus="true" @ondialogdismiss="CloseAddSourceDialog" aria-label="Add Xtream source">
        <FluentDialogHeader>Add Xtream source</FluentDialogHeader>
        <FluentDialogBody>
            <div class="dialog-form-grid">
                <FluentSelect TOption="string" Value="@_sourceDiscoveryForm.Protocol" ValueChanged="HandleSourceDiscoveryProtocolChangedAsync" Label="Protocol" Disabled="@_isSourceDiscoverySaving">
                    <FluentOption Value="https">HTTPS</FluentOption>
                    <FluentOption Value="http">HTTP</FluentOption>
                </FluentSelect>
                <FluentTextField @bind-Value="_sourceDiscoveryForm.HostOrBaseUrl" Placeholder="example.com" Label="Host / Base URL" Disabled="@_isSourceDiscoverySaving" />
                <FluentNumberField TValue="int?" @bind-Value="_sourceDiscoveryForm.Port" Label="Port" Disabled="@_isSourceDiscoverySaving" />
                <FluentTextField @bind-Value="_sourceDiscoveryForm.Username" Label="Username" Disabled="@_isSourceDiscoverySaving" />
                <FluentTextField @bind-Value="_sourceDiscoveryForm.Password" TextFieldType="TextFieldType.Password" Label="Password" Disabled="@_isSourceDiscoverySaving" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_sourceDiscoveryErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_sourceDiscoveryErrorMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseAddSourceDialog" Disabled="@_isSourceDiscoverySaving">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="DiscoverSourceAsync" Disabled="@_isSourceDiscoverySaving" Loading="@_isSourceDiscoverySaving">
                Connect &amp; Import
            </FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_isAddRuleDialogOpen)
{
    <FluentDialog Modal="true" TrapFocus="true" @ondialogdismiss="CloseAddRuleDialog" aria-label="Add category rule">
        <FluentDialogHeader>Add category rule</FluentDialogHeader>
        <FluentDialogBody>
            <div class="dialog-form-grid">
                <FluentSelect TOption="string" Value="@_newRule.Action.ToString()" ValueChanged="value => _newRule.Action = ParseAction(value)" Label="Action" Disabled="@_isRuleCreating">
                    <FluentOption Value="@CategoryRuleActionOption.Include.ToString()">Include</FluentOption>
                    <FluentOption Value="@CategoryRuleActionOption.Exclude.ToString()">Exclude</FluentOption>
                </FluentSelect>
                <FluentSelect TOption="string" Value="@_newRule.Operator.ToString()" ValueChanged="value => _newRule.Operator = ParseOperator(value)" Label="Match" Disabled="@_isRuleCreating">
                    <FluentOption Value="@CategoryRuleOperatorOption.Contains.ToString()">Contains</FluentOption>
                    <FluentOption Value="@CategoryRuleOperatorOption.StartsWith.ToString()">StartsWith</FluentOption>
                </FluentSelect>
                <FluentTextField @bind-Value="_newRule.Pattern" Maxlength="255" Label="Pattern" Disabled="@_isRuleCreating" />
                <FluentSelect TOption="string" Value="@_newRule.CaseSensitive.ToString().ToLowerInvariant()" ValueChanged="value => _newRule.CaseSensitive = string.Equals(value, bool.TrueString, StringComparison.OrdinalIgnoreCase)" Label="Case" Disabled="@_isRuleCreating">
                    <FluentOption Value="false">Ignore case</FluentOption>
                    <FluentOption Value="true">Case sensitive</FluentOption>
                </FluentSelect>
            </div>
            <FluentSwitch @bind-Value="_newRule.IsEnabled" CheckedMessage="On" UncheckedMessage="Off">Enabled</FluentSwitch>

            @if (!string.IsNullOrWhiteSpace(_ruleCreateErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_ruleCreateErrorMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseAddRuleDialog" Disabled="@_isRuleCreating">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="CreateRuleAsync" Disabled="@_isRuleCreating" Loading="@_isRuleCreating">Add rule</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_pendingRuleDelete is not null)
{
    <FluentDialog Modal="true" TrapFocus="true" @ondialogdismiss="CloseRuleDeleteDialog" aria-label="Delete category rule">
        <FluentDialogHeader>Delete category rule?</FluentDialogHeader>
        <FluentDialogBody>
            <p>@FormatRuleSummary(_pendingRuleDelete)</p>
            <p class="category-meta">This rule will no longer affect matching source categories.</p>
            @if (!string.IsNullOrWhiteSpace(_ruleDeleteErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_ruleDeleteErrorMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseRuleDeleteDialog" Disabled="@_isRuleDeleteSaving">Cancel</FluentButton>
            <FluentButton Class="destructive-button" Appearance="Appearance.Accent" @onclick="DeletePendingRuleAsync" Disabled="@_isRuleDeleteSaving" Loading="@_isRuleDeleteSaving">Delete</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_isCustomCategoryUsageDialogOpen)
{
    <FluentDialog Class="usage-dialog" Modal="true" TrapFocus="true" @ondialogdismiss="CloseCustomCategoryUsagesDialog" aria-label="Custom category usage">
        <FluentDialogHeader>@(_customCategoryUsageTitle ?? "Custom category usage")</FluentDialogHeader>
        <FluentDialogBody>
            @if (_isCustomCategoryUsageLoading)
            {
                <div class="loading-card compact-loading-card">
                    <FluentProgressRing />
                    <span>Loading usage…</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_customCategoryUsageErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_customCategoryUsageErrorMessage</FluentMessageBar>
            }
            else
            {
                <p class="category-meta">Used by @_customCategoryUsages.Count source categor@(_customCategoryUsages.Count == 1 ? "y" : "ies").</p>
                <div class="table-scroll">
                    <table class="category-grid usage-grid">
                        <colgroup>
                            <col class="usage-source-column" />
                            <col class="usage-type-column" />
                            <col class="usage-category-column" />
                            <col class="usage-action-column" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>Type</th>
                                <th>Source Category</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usage in _customCategoryUsages)
                            {
                                <tr>
                                    <td class="nowrap-cell">@FormatSourceDisplayName(usage.Summary.SourceDisplayName)</td>
                                    <td class="nowrap-cell">@usage.Summary.ContentType</td>
                                    <td>
                                        <div class="category-name">@usage.Summary.UpstreamCategoryName</div>
                                        <div class="category-meta">Upstream ID @usage.Summary.UpstreamCategoryId</div>
                                        @if (!string.IsNullOrWhiteSpace(usage.ErrorMessage))
                                        {
                                            <div class="inline-error">@usage.ErrorMessage</div>
                                        }
                                    </td>
                                    <td>
                                        @if (usage.IsConfirmingUnlink)
                                        {
                                            <div class="inline-editor-actions">
                                                <span class="category-meta">Return to Original?</span>
                                                <FluentButton Appearance="Appearance.Accent" @onclick="() => UnlinkCustomCategoryUsageAsync(usage)" Disabled="@usage.IsBusy">@(usage.IsBusy ? "Unlinking…" : "Unlink")</FluentButton>
                                                <FluentButton Appearance="Appearance.Neutral" @onclick="() => CancelCustomCategoryUsageUnlink(usage)" Disabled="@usage.IsBusy">Cancel</FluentButton>
                                            </div>
                                        }
                                        else
                                        {
                                            <FluentButton Appearance="Appearance.Neutral"
                                                          Title="Unlink source category"
                                                          AriaLabel="Unlink source category"
                                                          @onclick="() => BeginCustomCategoryUsageUnlink(usage)"
                                                          Disabled="@usage.IsBusy">
                                                <span>Unlink</span>
                                            </FluentButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseCustomCategoryUsagesDialog">Close</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_isNewCustomCategoryDialogOpen)
{
    <FluentDialog Modal="true" TrapFocus="true" @ondialogdismiss="CloseNewCustomCategoryDialog" aria-label="Create custom category">
        <FluentDialogHeader>Create custom category</FluentDialogHeader>
        <FluentDialogBody>
            <div class="dialog-form-grid dialog-form-grid-single">
                <FluentTextField Value="@_selectedContentType.ToString()" ReadOnly="true" Label="Content type" />
                <FluentTextField @bind-Value="_newCustomCategory.DisplayName" Maxlength="255" Placeholder="Movies 4K" Label="Name" Disabled="@_isCustomCategoryCreating" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_customCategoryCreateErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_customCategoryCreateErrorMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseNewCustomCategoryDialog" Disabled="@_isCustomCategoryCreating">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="CreateStandaloneCustomCategoryAsync" Disabled="@_isCustomCategoryCreating" Loading="@_isCustomCategoryCreating">Create</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@if (_pendingCustomCategoryDelete is not null)
{
    <FluentDialog Modal="true" TrapFocus="true" @ondialogdismiss="CloseCustomCategoryDeleteDialog" aria-label="Delete custom category">
        <FluentDialogHeader>Delete custom category?</FluentDialogHeader>
        <FluentDialogBody>
            <p>@_pendingCustomCategoryDelete.DisplayName</p>
            <p class="category-meta">This custom category is unused and can be removed.</p>
            @if (!string.IsNullOrWhiteSpace(_customCategoryDeleteErrorMessage))
            {
                <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">@_customCategoryDeleteErrorMessage</FluentMessageBar>
            }
        </FluentDialogBody>
        <FluentDialogFooter>
            <FluentButton Appearance="Appearance.Neutral" @onclick="CloseCustomCategoryDeleteDialog" Disabled="@_isCustomCategoryDeleteSaving">Cancel</FluentButton>
            <FluentButton Class="destructive-button" Appearance="Appearance.Accent" @onclick="DeletePendingCustomCategoryAsync" Disabled="@_isCustomCategoryDeleteSaving" Loading="@_isCustomCategoryDeleteSaving">Delete</FluentButton>
        </FluentDialogFooter>
    </FluentDialog>
}

@code {
    private static readonly IReadOnlyDictionary<string, CategoriesTab> _tabs = new Dictionary<string, CategoriesTab>
    {
        ["Source Categories"] = CategoriesTab.SourceCategories,
        ["Category Rules"] = CategoriesTab.CategoryRules,
        ["Global Custom Categories"] = CategoriesTab.GlobalCustomCategories
    };

    private AdminCategoriesPayload? _categoryView;
    private AdminCategoryRulesPayload? _rulesView;
    private List<CategoryRowState> _categoryRows = [];
    private List<RuleRowState> _ruleRows = [];
    private List<CustomCategoryRowState> _customCategoryRows = [];
    private RuleEditorState _newRule = new() { IsEnabled = true };
    private RuleTesterState _ruleTester = new();
    private CustomCategoryEditorState _newCustomCategory = new();
    private SourceDiscoveryFormState _sourceDiscoveryForm = SourceDiscoveryFormState.CreateDefault();
    private bool _isLoading = true;
    private bool _isCategoryDataRefreshing;
    private bool _isRulesRefreshing;
    private int? _selectedSourceId;
    private AdminContentType _selectedContentType = AdminContentType.Vod;
    private string _searchText = string.Empty;
    private CategoryStatusFilter _statusFilter = CategoryStatusFilter.All;
    private CategoriesTab _activeTab = CategoriesTab.SourceCategories;
    private int? _highlightedRuleId;
    private bool _isRuleCreating;
    private bool _isAddRuleDialogOpen;
    private string? _ruleCreateErrorMessage;
    private bool _isCustomCategoryCreating;
    private bool _isNewCustomCategoryDialogOpen;
    private string? _customCategoryCreateErrorMessage;
    private string? _pageErrorMessage;
    private string? _categoryMessage;
    private string? _categoryErrorMessage;
    private string? _ruleMessage;
    private string? _ruleErrorMessage;
    private string? _customCategoryMessage;
    private string? _customCategoryErrorMessage;
    private bool _isAddSourceDialogOpen;
    private bool _isSourceDiscoverySaving;
    private string? _sourceDiscoveryErrorMessage;
    private RuleRowState? _pendingRuleDelete;
    private bool _isRuleDeleteSaving;
    private string? _ruleDeleteErrorMessage;
    private bool _isCustomCategoryUsageDialogOpen;
    private bool _isCustomCategoryUsageLoading;
    private string? _customCategoryUsageTitle;
    private string? _customCategoryUsageErrorMessage;
    private int? _customCategoryUsageCustomCategoryId;
    private List<CustomCategoryUsageRowState> _customCategoryUsages = [];
    private CustomCategoryRowState? _pendingCustomCategoryDelete;
    private bool _isCustomCategoryDeleteSaving;
    private string? _customCategoryDeleteErrorMessage;

    private IReadOnlyList<CategoryRowState> FilteredCategoryRows => CategoriesPageState.FilterCategoryRows(_categoryRows, _searchText, _statusFilter);

    private string ActiveTabId
    {
        get => _activeTab.ToString();
        set
        {
            if (Enum.TryParse<CategoriesTab>(value, true, out var tab))
            {
                _activeTab = tab;
            }
        }
    }

    private static string FormatSourceDisplayName(string displayName)
    {
        if (!Uri.TryCreate(displayName, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            return displayName;
        }

        var path = uri.AbsolutePath.TrimEnd('/');
        return string.IsNullOrEmpty(path) || path == "/"
            ? uri.Authority
            : $"{uri.Authority}{path}";
    }

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryString();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _pageErrorMessage = null;
        _categoryMessage = null;
        _categoryErrorMessage = null;
        _ruleMessage = null;
        _ruleErrorMessage = null;
        _ruleCreateErrorMessage = null;
        _customCategoryMessage = null;
        _customCategoryErrorMessage = null;
        _customCategoryCreateErrorMessage = null;

        try
        {
            await RefreshAllDataCoreAsync();
        }
        catch (Exception exception)
        {
            _pageErrorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAllDataCoreAsync()
    {
        var categoriesPayload = await CategoriesClient.GetCategoriesAsync(_selectedSourceId, _selectedContentType);
        ApplyCategoryView(categoriesPayload);

        var rulesPayload = await CategoriesClient.GetRulesAsync(_selectedSourceId, _selectedContentType);
        ApplyRulesView(rulesPayload);
    }

    private async Task RefreshCategoriesViewAsync(int? markSavedCategoryId = null, string? message = null)
    {
        _isCategoryDataRefreshing = true;
        _categoryErrorMessage = null;
        _pageErrorMessage = null;

        try
        {
            var payload = await CategoriesClient.GetCategoriesAsync(_selectedSourceId, _selectedContentType);
            ApplyCategoryView(payload);

            if (markSavedCategoryId is int savedCategoryId
                && _categoryRows.SingleOrDefault(row => row.Summary.Id == savedCategoryId) is { } savedRow)
            {
                savedRow.CommitMapping(savedRow.MappingValue);
            }

            _categoryMessage = message;
        }
        catch (Exception exception)
        {
            _categoryErrorMessage = exception.Message;
        }
        finally
        {
            _isCategoryDataRefreshing = false;
        }
    }

    private async Task RefreshRulesAndCategoryViewsAsync(string? message = null, int? highlightRuleId = null)
    {
        _isCategoryDataRefreshing = true;
        _isRulesRefreshing = true;
        _ruleErrorMessage = null;
        _pageErrorMessage = null;

        try
        {
            await RefreshAllDataCoreAsync();
            _highlightedRuleId = highlightRuleId;
            _ruleMessage = message;
            _ruleCreateErrorMessage = null;
        }
        catch (Exception exception)
        {
            _ruleErrorMessage = exception.Message;
        }
        finally
        {
            _isCategoryDataRefreshing = false;
            _isRulesRefreshing = false;
        }
    }

    private void ApplyCategoryView(AdminCategoriesPayload payload)
    {
        _categoryView = payload;
        _selectedSourceId = payload.SelectedSourceId;
        _selectedContentType = Enum.TryParse<AdminContentType>(payload.SelectedContentType, true, out var parsedContentType)
            ? parsedContentType
            : _selectedContentType;
        _customCategoryRows = payload.CustomCategories.Select(summary => new CustomCategoryRowState(summary)).ToList();
        _categoryRows = payload.UpstreamCategories.Select(summary => new CategoryRowState(summary)).ToList();
    }

    private CategoryRowState GetCategoryRow(int upstreamCategoryRecordId) =>
        _categoryRows.Single(row => row.Summary.Id == upstreamCategoryRecordId);

    private void ApplyCategoryMappingResponse(int upstreamCategoryRecordId, AdminCategoryMappingResponse response)
    {
        var row = GetCategoryRow(upstreamCategoryRecordId);
        var previousCustomCategoryId = row.Summary.CustomCategoryId;
        var mappingSelection = Enum.TryParse<CategoryMappingSelectionOption>(response.MappingSelection, true, out var parsedSelection)
            ? parsedSelection
            : throw new InvalidOperationException("The backend returned an invalid category mapping selection.");

        row.ApplyPersistedMapping(mappingSelection, response.CustomCategory);

        if (previousCustomCategoryId is int oldCustomCategoryId
            && oldCustomCategoryId != response.CustomCategory?.Id
            && _customCategoryRows.SingleOrDefault(customCategory => customCategory.Summary.Id == oldCustomCategoryId) is { } previousCustomCategory)
        {
            previousCustomCategory.SetUsageCount(previousCustomCategory.UsageCount - 1);
        }

        if (response.CustomCategory is null)
        {
            return;
        }

        var existingRow = _customCategoryRows.SingleOrDefault(customCategory => customCategory.Summary.Id == response.CustomCategory.Id);
        if (existingRow is not null)
        {
            existingRow.RefreshSummary(response.CustomCategory);
            return;
        }

        _customCategoryRows.Add(new CustomCategoryRowState(response.CustomCategory));
        _customCategoryRows = _customCategoryRows
            .OrderBy(customCategory => customCategory.Summary.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(customCategory => customCategory.Summary.Id)
            .ToList();
    }

    private void ApplyRulesView(AdminCategoryRulesPayload payload)
    {
        _rulesView = payload;
        _ruleRows = payload.Rules.Select(summary => new RuleRowState(summary)).ToList();
        if (_highlightedRuleId is int highlightedRuleId && _ruleRows.All(rule => rule.RuleId != highlightedRuleId))
        {
            _highlightedRuleId = null;
        }
    }

    private void ApplyQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("sourceId", out var sourceValues)
            && int.TryParse(sourceValues[0], NumberStyles.None, CultureInfo.InvariantCulture, out var parsedSourceId))
        {
            _selectedSourceId = parsedSourceId;
        }

        if (query.TryGetValue("contentType", out var contentTypeValues)
            && Enum.TryParse<AdminContentType>(contentTypeValues[0], true, out var parsedContentType))
        {
            _selectedContentType = parsedContentType;
        }
    }

    private Task OnSearchChangedAsync(string? value)
    {
        _searchText = value?.Trim() ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnStatusFilterChangedAsync(CategoryStatusFilter value)
    {
        _statusFilter = value;
        return Task.CompletedTask;
    }

    private async Task OnSourceChangedAsync(int? value)
    {
        _selectedSourceId = value;
        UpdateLocation();
        await ReloadAsync();
    }

    private async Task OnContentTypeChangedAsync(AdminContentType value)
    {
        _selectedContentType = value;
        UpdateLocation();
        await ReloadAsync();
    }

    private void UpdateLocation()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sourceId"] = _selectedSourceId,
            ["contentType"] = _selectedContentType.ToString()
        });

        if (!string.Equals(uri, NavigationManager.Uri, StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(uri, replace: true);
        }
    }

    private async Task OnMappingSelectionChangedAsync(CategoryMappingChangeRequest request)
    {
        var row = GetCategoryRow(request.UpstreamCategoryRecordId);
        _categoryMessage = null;
        _categoryErrorMessage = null;
        row.ClearFeedback();
        row.MappingValue = request.MappingValue ?? row.MappingValue;

        if (row.MappingValue == "new")
        {
            row.BeginCustomCategoryCreate();
            return;
        }

        await SaveCategoryMappingAsync(row, row.MappingValue, null);
    }

    private Task CancelCustomCategoryCreate(int upstreamCategoryRecordId)
    {
        var row = GetCategoryRow(upstreamCategoryRecordId);
        row.CancelCustomCategoryCreate();
        return Task.CompletedTask;
    }

    private Task RetryCategoryMappingAsync(int upstreamCategoryRecordId)
    {
        var row = GetCategoryRow(upstreamCategoryRecordId);
        return SaveCategoryMappingAsync(
            row,
            row.PendingMappingValue ?? row.MappingValue,
            row.PendingNewCustomCategoryName ?? row.NewCustomCategoryName);
    }

    private Task OpenMatchedRuleAsync(int upstreamCategoryRecordId)
    {
        var row = GetCategoryRow(upstreamCategoryRecordId);
        if (row.Summary.MatchedRuleId is int matchedRuleId)
        {
            _highlightedRuleId = matchedRuleId;
            _activeTab = CategoriesTab.CategoryRules;
        }

        return Task.CompletedTask;
    }

    private Task CreateCustomCategoryAsync(int upstreamCategoryRecordId)
    {
        var row = GetCategoryRow(upstreamCategoryRecordId);
        return SaveCategoryMappingAsync(row, "new", row.NewCustomCategoryName);
    }

    private async Task SaveCategoryMappingAsync(CategoryRowState row, string mappingValue, string? newCustomCategoryName)
    {
        if (_selectedSourceId is null)
        {
            row.Fail("A source must be selected.");
            return;
        }

        try
        {
            row.BeginSave(mappingValue, newCustomCategoryName);

            var request = mappingValue switch
            {
                "disabled" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Disabled", null, null),
                "original" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Original", null, null),
                "new" => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Custom", null, newCustomCategoryName),
                _ when mappingValue.StartsWith("custom:", StringComparison.Ordinal)
                    && int.TryParse(mappingValue[7..], NumberStyles.None, CultureInfo.InvariantCulture, out var customCategoryId)
                    => new AdminCategoryMappingUpdate(_selectedSourceId.Value, _selectedContentType.ToString(), "Custom", customCategoryId, null),
                _ => throw new InvalidOperationException("Invalid category mapping selection.")
            };

            var response = await CategoriesClient.UpdateCategoryMappingAsync(row.Summary.Id, request);
            ApplyCategoryMappingResponse(row.Summary.Id, response);
            _categoryMessage = "Mapping saved.";
        }
        catch (Exception exception)
        {
            row.Fail(exception.Message);
        }
    }

