@page "/sources"
@using System.Net
@using XtreamForge.Web.Features.Categories
@implements IDisposable
@inject SourcesClient SourcesClient
@inject INotificationService NotificationService
@inject IDialogService DialogService

<PageTitle>Xtream sources - XtreamForge</PageTitle>

<PageHeader Title="Xtream sources" Subtitle="Xtream providers known by XtreamForge. Adding a source discovers its VOD and series categories.">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                      Loading="@_isRefreshing"
                      Disabled="@_isLoading"
                      OnClick="@RefreshAsync">
            Refresh
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      IconStart="@(new Icons.Regular.Size16.Add())"
                      Disabled="@(_isLoading || _loadError is not null)"
                      OnClick="@OpenEditorAsync">
            New source
        </FluentButton>
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <FluentCard Class="surface">
        <div class="skeleton-list" aria-busy="true">
            @for (var index = 0; index < 2; index++)
            {
                <FluentSkeleton Width="100%" Height="9rem" Shimmer="true" />
            }
        </div>
    </FluentCard>
}
else if (_loadError is not null)
{
    <FluentCard Class="surface">
        <LoadErrorState Title="Unable to load the sources" Error="@_loadError" IsRetrying="@_isRefreshing" OnRetry="@RefreshAsync" />
    </FluentCard>
}
else if (_sources.Count == 0)
{
    <FluentCard Class="surface">
        <EmptyState Title="No source yet"
                    Description="Add an Xtream provider to discover its categories and start filtering them."
                    Icon="@(new Icons.Regular.Size24.PlugConnected())">
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="@OpenEditorAsync">New source</FluentButton>
        </EmptyState>
    </FluentCard>
}
else
{
    <div class="source-overview" aria-live="polite">
        <div class="source-overview-item">
            <strong>@_sources.Count.ToString("N0", CultureInfo.CurrentCulture)</strong>
            <span>@(_sources.Count == 1 ? "source" : "sources")</span>
        </div>
        <div class="source-overview-item">
            <strong>@_sources.Sum(source => source.TotalEffectiveCategories).ToString("N0", CultureInfo.CurrentCulture)</strong>
            <span>categories sent to clients, out of @_sources.Sum(source => source.TotalCategories).ToString("N0", CultureInfo.CurrentCulture)</span>
        </div>
        <div class="source-overview-item">
            <strong>@_sources.Sum(source => source.TotalRules).ToString("N0", CultureInfo.CurrentCulture)</strong>
            <span>rules</span>
        </div>
        <div class="source-overview-item">
            <strong>@_sources.Sum(source => source.TotalTmdbMappings).ToString("N0", CultureInfo.CurrentCulture)</strong>
            <span>TMDB IDs resolved</span>
        </div>
    </div>

    <ul class="source-list" aria-label="Xtream sources">
        @foreach (var source in _sources)
        {
            var isBusy = _busyIds.Contains(source.Id);
            <li @key="source.Id">
                <FluentCard Class="surface source-card">
                    <div class="source-card-header">
                        <span class="source-card-icon" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size20.PlugConnected())" /></span>
                        <div class="source-card-title">
                            <span class="source-card-name cell-truncate" title="@source.DisplayName">@source.DisplayName</span>
                            <span class="cell-secondary">ID @source.Id</span>
                        </div>
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" IconOnly="true"
                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                      aria-label="@($"Delete {source.DisplayName}")" Tooltip="Delete"
                                      Loading="@isBusy"
                                      Disabled="@isBusy"
                                      OnClick="@(() => DeleteAsync(source))" />
                    </div>
                    <div class="source-blocks">
                        <SourceContentFacts SourceId="@source.Id" ContentType="ContentType.Vod" Summary="@source.Vod" />
                        <SourceContentFacts SourceId="@source.Id" ContentType="ContentType.Series" Summary="@source.Series" />
                    </div>
                </FluentCard>
            </li>
        }
    </ul>
}

<FluentDialog @ref="_dialog" OnStateChange="@OnDialogStateChange" PreventDismissOnEscape="@_isSaving">
    <FluentDialogBody>
        <TitleTemplate>
            New source
        </TitleTemplate>
        <ChildContent>
            @if (_isEditorOpen)
            {
                <form class="dialog-form" @onsubmit="@SaveAsync">
                    <FluentTextInput Label="URL"
                                     @bind-Value="_editorUrl"
                                     Immediate="true"
                                     Autofocus="true"
                                     Disabled="@_isSaving"
                                     Placeholder="For example: http://provider.example.com:8080"
                                     Width="100%" />
                    <FluentTextInput Label="Username"
                                     @bind-Value="_editorUsername"
                                     Immediate="true"
                                     Disabled="@_isSaving"
                                     autocomplete="off"
                                     Width="100%" />
                    <FluentTextInput Label="Password"
                                     @bind-Value="_editorPassword"
                                     TextInputType="TextInputType.Password"
                                     Immediate="true"
                                     Disabled="@_isSaving"
                                     autocomplete="new-password"
                                     Message="@_editorError"
                                     MessageCondition="@(field => !string.IsNullOrEmpty(field.Message))"
                                     MessageState="@(_editorError is null ? null : MessageState.Error)"
                                     Width="100%" />
                    <span class="cell-secondary">The credentials are only used to discover the categories; they are not stored.</span>
                </form>
            }
        </ChildContent>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="@_isSaving" Disabled="@(!CanSave)" OnClick="@SaveAsync">Create</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="@_isSaving" OnClick="@CloseEditorAsync">Cancel</FluentButton>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

@code {
    private readonly CancellationTokenSource _disposal = new();
    private readonly HashSet<int> _busyIds = [];
    private IReadOnlyList<XtreamSourceSummaryDto> _sources = [];
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isSaving;
    private Exception? _loadError;
    private FluentDialog? _dialog;
    private bool _isEditorOpen;
    private string? _editorUrl;
    private string? _editorUsername;
    private string? _editorPassword;
    private string? _editorError;

    private bool CanSave => !_isSaving
        && !string.IsNullOrWhiteSpace(_editorUrl)
        && !string.IsNullOrWhiteSpace(_editorUsername)
        && !string.IsNullOrWhiteSpace(_editorPassword);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync(bool showLoading = true)
    {
        _isLoading = showLoading;
        try
        {
            var sources = await SourcesClient.GetSourcesAsync(_disposal.Token);
            _sources = [.. sources.OrderBy(source => source.DisplayName, StringComparer.OrdinalIgnoreCase)];
            _loadError = null;
        }
        catch (Exception exception) when (!_disposal.IsCancellationRequested)
        {
            _loadError = exception;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _isRefreshing = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task OpenEditorAsync()
    {
        if (_dialog is null)
        {
            return;
        }

        ResetEditor();
        _isEditorOpen = true;
        await _dialog.ShowAsync();
    }

    private async Task CloseEditorAsync()
    {
        if (_dialog is not null)
        {
            await _dialog.HideAsync();
        }

        ResetEditor();
    }

    // Also called when the dialog is dismissed with Escape.
    private void OnDialogStateChange(DialogEventArgs args)
    {
        if (args.State == DialogState.Closed)
        {
            ResetEditor();
        }
    }

    // The credentials are cleared as soon as the dialog closes so they do not stay in the circuit state.
    private void ResetEditor()
    {
        _isEditorOpen = false;
        _editorUrl = null;
        _editorUsername = null;
        _editorPassword = null;
        _editorError = null;
    }

    private async Task SaveAsync()
    {
        if (!_isEditorOpen || !CanSave)
        {
            return;
        }

        var url = _editorUrl!.Trim();
        _isSaving = true;
        _editorError = null;
        try
        {
            var result = await SourcesClient.CreateSourceAsync(new SourceCreateRequest(url, _editorUsername!.Trim(), _editorPassword!), _disposal.Token);
            switch (result)
            {
                case SourceCreateResult.Conflict:
                    _editorError = $"The source \"{url}\" already exists.";
                    break;
                case SourceCreateResult.Invalid:
                    _editorError = "Check the URL: it must be an absolute http or https URL of an allowed provider.";
                    break;
                case SourceCreateResult.ProviderUnavailable:
                    _editorError = "The provider could not be reached or rejected the credentials. Nothing was created.";
                    break;
                default:
                    await CloseEditorAsync();
                    await NotificationService.ShowSuccessToastAsync($"Source \"{url}\" created and its categories discovered.");
                    await LoadAsync(showLoading: false);
                    break;
            }
        }
        catch (Exception exception) when (!_disposal.IsCancellationRequested)
        {
            _editorError = $"Unable to create the source. {ApiErrorMessage.Describe(exception)}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync(XtreamSourceSummaryDto source)
    {
        if (!_busyIds.Add(source.Id))
        {
            return;
        }

        try
        {
            var confirmation = await DialogService.ShowConfirmationAsync(
                $"Delete the source <strong>{WebUtility.HtmlEncode(source.DisplayName)}</strong>? Its Xtream categories, category rules, item rules and TMDB mappings are deleted as well. Custom categories are kept. This cannot be undone.",
                "Delete source",
                "Delete",
                "Cancel");
            if (confirmation.Cancelled)
            {
                return;
            }

            var result = await SourcesClient.DeleteSourceAsync(source.Id, _disposal.Token);
            if (result == AdminOperationResult.NotFound)
            {
                await NotificationService.ShowWarningToastAsync($"\"{source.DisplayName}\" no longer exists.");
            }
            else
            {
                await NotificationService.ShowSuccessToastAsync($"Source \"{source.DisplayName}\" deleted.");
            }

            await LoadAsync(showLoading: false);
        }
        catch (Exception exception) when (!_disposal.IsCancellationRequested)
        {
            await NotificationService.ShowErrorToastAsync($"Unable to delete \"{source.DisplayName}\".", ApiErrorMessage.Describe(exception));
        }
        finally
        {
            _busyIds.Remove(source.Id);
        }
    }

    public void Dispose()
    {
        _disposal.Cancel();
        _disposal.Dispose();
    }
}
