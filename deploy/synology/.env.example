# Copy this file to .env next to docker-compose.yml (.env is never committed: *.env is git-ignored)

# TMDB API read access token (themoviedb.org > Settings > API, the long "read access token"), required:
# without it no metadata is loaded and the catalogue stays empty
TMDB_API_KEY=my-tmdb-read-access-token

# Upstream Xtream provider hosts, without http:// or port
# XTREAM_HOST_0 is required; XTREAM_HOST_1 and XTREAM_HOST_2 are optional (leave them empty if unused)
XTREAM_HOST_0=provider1.example.com
XTREAM_HOST_1=
XTREAM_HOST_2=

# Subnet of the npm_internal Docker network (CIDR), so that Nginx Proxy Manager is trusted, required.
# Find it with: sudo docker network inspect npm_internal --format '{{(index .IPAM.Config 0).Subnet}}'
REVERSE_PROXY_NETWORK=172.20.0.0/16

# Database password, make up a long one
POSTGRES_PASSWORD=change-me
