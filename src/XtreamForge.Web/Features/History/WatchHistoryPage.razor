@page "/history"
@using System.Net
@using XtreamForge.Web.Features.Categories
@implements IDisposable
@inject WatchHistoryClient WatchHistoryClient
@inject BrowserTimeZone BrowserTimeZone
@inject INotificationService NotificationService
@inject IDialogService DialogService

<PageTitle>Watch history - XtreamForge</PageTitle>

<PageHeader Title="Watch history" Subtitle="Movies and series episodes played through the proxy or added from the TMDB infos, the most recent first. A title played several times appears once per playback.">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                      Loading="@_isRefreshing"
                      OnClick="@RefreshAsync">
            Refresh
        </FluentButton>
    </Actions>
</PageHeader>

<FluentCard Class="surface filter-bar">
    <div class="filter-row">
        <SegmentedControl TValue="ContentType?" Label="Content type" Options="@ContentTypeOptions" Value="@_contentType" ValueChanged="@SetContentTypeAsync" />
    </div>
</FluentCard>

<FluentCard Class="surface grid-surface">
    @if (_loadError is not null)
    {
        <LoadErrorState Title="Unable to load the watch history" Error="@_loadError" IsRetrying="@_isRefreshing" OnRetry="@RefreshAsync" />
    }
    else if (_page is { MatchingCount: 0 })
    {
        <EmptyState Title="No playback yet"
                    Description="A playback appears once a client plays a movie or a series episode through the proxy and its TMDB ID is known. An episode is only recognized once the client has listed the episodes of its series through the proxy."
                    Icon="@(new Icons.Regular.Size24.History())" />
    }
    else
    {
        <div class="grid-caption" aria-live="polite">
            @if (_page is { } counters)
            {
                <span><strong>@counters.MatchingCount.ToString("N0", CultureInfo.CurrentCulture)</strong> playbacks</span>
            }
        </div>

        <div class="grid-viewport grid-viewport-full">
            <FluentDataGrid @ref="_grid"
                            TGridItem="WatchHistoryEntryDto"
                            ItemsProvider="@_itemsProvider"
                            ItemKey="@(entry => entry.Id)"
                            Virtualize="true"
                            ItemSize="64"
                            GridTemplateColumns="minmax(150px, 0.8fr) minmax(260px, 2.5fr) 120px 64px">
                <TemplateColumn Title="Started" HeaderTooltip="Start of the playback, in the time zone of the browser">
                    <span class="cell-secondary">@FormatStartedAt(context.StartedAtUtc)</span>
                </TemplateColumn>
                <TemplateColumn Title="Title">
                    <div class="media-cell">
                        @if (context.PosterThumbnailUrl is { } posterUrl)
                        {
                            <img class="poster-thumb" src="@posterUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="poster-thumb poster-thumb-empty" aria-hidden="true">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Image())" />
                            </span>
                        }
                        <div class="cell-stack">
                            <a class="text-link cell-primary cell-truncate" href="@context.TmdbUrl" target="_blank" rel="noopener noreferrer" title="@context.DisplayTitle">@context.DisplayTitle</a>
                            <span class="cell-secondary cell-truncate">@context.Subtitle</span>
                        </div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Type">
                    <ContentTypePill ContentType="@context.ContentType" />
                </TemplateColumn>
                <TemplateColumn Title="" Align="DataGridCellAlignment.End">
                    @{
                        var isBusy = _busyIds.Contains(context.Id);
                    }
                    <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" IconOnly="true"
                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                  aria-label="@($"Delete the playback of {context.FullTitle}")" Tooltip="Delete"
                                  Loading="@isBusy"
                                  Disabled="@isBusy"
                                  OnClick="@(() => DeleteAsync(context))" />
                </TemplateColumn>
            </FluentDataGrid>
        </div>
    }
</FluentCard>

@code {
    // the API returns at most 200 entries per request; the virtualized grid requests the visible rows and a few more
    private const int PageSize = 100;

    // a null content type lists every playback
    private static readonly IReadOnlyList<SegmentOption<ContentType?>> ContentTypeOptions =
    [
        new(null, "All"),
        .. CategoryLabels.ContentTypes.Select(type => new SegmentOption<ContentType?>(type, CategoryLabels.ContentTypeName(type), CategoryLabels.ContentTypeIcon(type)))
    ];

    private readonly CancellationTokenSource _disposal = new();
    private readonly HashSet<int> _busyIds = [];
    private GridItemsProvider<WatchHistoryEntryDto>? _itemsProvider;
    private FluentDataGrid<WatchHistoryEntryDto>? _grid;
    private WatchHistoryPageDto? _page;
    private ContentType? _contentType;
    private TimeZoneInfo? _timeZone;
    private bool _isRefreshing;
    private Exception? _loadError;

    protected override void OnInitialized()
    {
        _itemsProvider = ProvideItemsAsync;
    }

    // The time zone of the browser is only readable once rendered; the start dates are shown once it is known.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _timeZone = await BrowserTimeZone.GetAsync(_disposal.Token);
        StateHasChanged();
    }

    private string FormatStartedAt(DateTimeOffset startedAtUtc) =>
        _timeZone is { } timeZone
            ? TimeZoneInfo.ConvertTime(startedAtUtc, timeZone).ToString("g", CultureInfo.CurrentCulture)
            : string.Empty;

    // Called by the virtualized grid for the visible rows; the API sorts and pages the history.
    private async ValueTask<GridItemsProviderResult<WatchHistoryEntryDto>> ProvideItemsAsync(GridItemsProviderRequest<WatchHistoryEntryDto> request)
    {
        try
        {
            var count = request.Count is int requested && requested > 0 ? Math.Min(requested, PageSize) : PageSize;
            var page = await WatchHistoryClient.GetPageAsync(_contentType, request.StartIndex, count, request.CancellationToken);

            var countChanged = _page?.MatchingCount != page.MatchingCount;
            _page = page;
            if (countChanged)
            {
                await InvokeAsync(StateHasChanged);
            }

            return GridItemsProviderResult.From([.. page.Items], page.MatchingCount);
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested || _disposal.IsCancellationRequested)
        {
            return GridItemsProviderResult.From<WatchHistoryEntryDto>([], 0);
        }
        catch (Exception exception) when (!_disposal.IsCancellationRequested)
        {
            _loadError = exception;
            await InvokeAsync(StateHasChanged);
            return GridItemsProviderResult.From<WatchHistoryEntryDto>([], 0);
        }
    }

    // The grid is shown again (and loads its first rows) after an error or an empty result; otherwise it reloads its rows.
    private async Task RefreshAsync()
    {
        _isRefreshing = true;
        try
        {
            var isGridShown = _loadError is null && _page is not { MatchingCount: 0 };
            _loadError = null;
            if (isGridShown && _grid is { } grid)
            {
                await grid.RefreshDataAsync();
            }
            else
            {
                _page = null;
                StateHasChanged();
            }
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task SetContentTypeAsync(ContentType? contentType)
    {
        if (contentType == _contentType)
        {
            return;
        }

        _contentType = contentType;
        await RefreshAsync();
    }

    private async Task DeleteAsync(WatchHistoryEntryDto entry)
    {
        var titleKind = entry.ContentType == ContentType.Series ? "series" : "movie";
        var confirmation = await DialogService.ShowConfirmationAsync(
            $"Delete the playback of <strong>{WebUtility.HtmlEncode(entry.FullTitle)}</strong> started on {WebUtility.HtmlEncode(FormatStartedAt(entry.StartedAtUtc))}? The {titleKind} can then be recommended again if it has no other playback. This cannot be undone.",
            "Delete playback",
            "Delete",
            "Cancel");
        if (confirmation.Cancelled || !_busyIds.Add(entry.Id))
        {
            return;
        }

        try
        {
            var result = await WatchHistoryClient.DeleteAsync(entry.Id, _disposal.Token);
            if (result == AdminOperationResult.Success)
            {
                await NotificationService.ShowSuccessToastAsync($"Playback of \"{entry.FullTitle}\" deleted.");
            }
            else
            {
                await NotificationService.ShowWarningToastAsync($"The playback of \"{entry.FullTitle}\" no longer exists.", "The list is reloaded.");
            }
        }
        catch (Exception exception) when (!_disposal.IsCancellationRequested)
        {
            await NotificationService.ShowErrorToastAsync($"Unable to delete the playback of \"{entry.FullTitle}\".", ApiErrorMessage.Describe(exception));
        }
        finally
        {
            _busyIds.Remove(entry.Id);
        }

        await RefreshAsync();
    }

    public void Dispose()
    {
        _disposal.Cancel();
        _disposal.Dispose();
    }
}
