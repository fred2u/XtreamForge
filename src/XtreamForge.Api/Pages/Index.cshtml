@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="page-subtitle">Early-stage operational view for the XtreamForge foundation.</p>

<div class="dashboard-grid">
    <section class="status-card">
        <h2>Application status</h2>
        <p class="status-value">@Model.ApplicationStatus</p>
        <p>@Model.ApplicationDetails</p>
    </section>

    <section class="status-card">
        <h2>Database connectivity</h2>
        <p class="status-value">@Model.DatabaseStatus</p>
        <p>@Model.DatabaseDetails</p>
    </section>
</div>
