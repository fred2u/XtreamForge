@using XtreamForge.Web.Features.Rules
@* Explains the decision computed by the API for one Xtream category, laid out like the TMDB info details. It does not evaluate any rule itself. *@
<div class="decision-details">
    @* the name is the title of the dialog *@
    <div class="decision-details-header">
        <span class="cell-secondary">@CategoryLabels.ContentTypeName(Category.ContentType) · @Source.DisplayName</span>
        <CategoryDecisionBadge Category="@Category" />
    </div>

    @switch (Category.ExclusionReason)
    {
        case CategoryExclusionReason.ManuallyExcluded:
        case CategoryExclusionReason.ProviderDisabled:
            <p class="decision-details-reason">
                <strong>@CategoryLabels.ExclusionReasonName(Category.ExclusionReason.Value).</strong>
                @CategoryLabels.ExclusionReasonDescription(Category.ExclusionReason.Value)
            </p>
            break;
        default:
            @if (Category.DecidingRule is { } rule)
            {
                <div class="decision-details-reason">
                    <p>
                        <strong>@(Category.Decision == InclusionDecision.Exclude ? "Excluded" : "Included") by category rule #@rule.Id,</strong>
                        the first enabled rule that matches.
                    </p>
                    <RuleSentence Action="@rule.Action" Operator="@rule.Operator" Pattern="@rule.Pattern" CaseSensitive="@rule.CaseSensitive"
                                  FieldName="@RuleKindTexts.FieldName(RuleKind.Category, rule.Field)" />
                    <p class="cell-secondary">@PriorityText(rule)</p>
                    <a class="text-link" href="@RulesHref(rule)">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Open())" aria-hidden="true" />
                        Open in category rules
                    </a>
                </div>
            }
            else
            {
                <p class="decision-details-reason">
                    <strong>No enabled category rule matches.</strong> Categories that no rule matches are included.
                </p>
            }
            break;
    }

    @Controls

    <dl class="rule-facts">
        <dt>Source</dt>
        <dd>@Source.DisplayName</dd>
        <dt>Xtream ID</dt>
        <dd>@Category.XtreamId</dd>
        <dt>Provider</dt>
        <dd>@(Category.IsEnabled ? "Enabled: currently returned by the provider" : "Disabled: no longer returned by the provider")</dd>
    </dl>
</div>

@code {
    [Parameter, EditorRequired]
    public XtreamCategoryDto Category { get; set; } = default!;

    [Parameter, EditorRequired]
    public XtreamSourceDto Source { get; set; } = default!;

    /// <summary>Rules of the same source and content type, used to show the position of the deciding rule.</summary>
    [Parameter]
    public IReadOnlyList<RuleDto> Rules { get; set; } = [];

    /// <summary>Settings changed from the details (manual exclusion, custom category), shown under the decision.</summary>
    [Parameter]
    public RenderFragment? Controls { get; set; }

    private string PriorityText(RuleDto rule)
    {
        var ordered = Rules.OrderBy(r => r.Sequence).ToList();
        var index = ordered.FindIndex(r => r.Id == rule.Id);
        return index < 0
            ? $"Sequence {rule.Sequence}"
            : $"Priority {index + 1} of {ordered.Count} (sequence {rule.Sequence})";
    }

    private string RulesHref(RuleDto rule) =>
        $"/categories/rules?source={Source.Id}&type={Category.ContentType}&rule={rule.Id}";
}
