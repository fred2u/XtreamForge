@inherits LayoutComponentBase

<FluentDesignTheme Mode="@DesignThemeModes.Light">
    <div class="layout-shell">
        <aside class="sidebar">
            <div class="brand-block">
                <FluentIcon Value="@(new Icons.Regular.Size24.Apps())" Color="Color.Accent" />
                <div>
                    <div class="brand">XtreamForge</div>
                    <div class="brand-subtitle">Administration</div>
                </div>
            </div>

            <FluentNavMenu Width="250" Title="Primary administration navigation">
                <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())">Dashboard</FluentNavLink>
                <FluentNavLink Href="/categories" Icon="@(new Icons.Regular.Size20.Grid())">Categories</FluentNavLink>
                <FluentNavLink Href="/settings" Icon="@(new Icons.Regular.Size20.Settings())">Settings</FluentNavLink>
            </FluentNavMenu>
        </aside>

        <main class="content">
            @Body
        </main>
    </div>

    <FluentToastProvider />
</FluentDesignTheme>
