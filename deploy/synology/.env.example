# Copy this file to .env next to docker-compose.yml (.env is never committed: *.env is git-ignored)

# Host ports on the NAS
API_PORT=8080
ADMIN_PORT=8081

# TMDB API read access token (themoviedb.org > Settings > API, the long "read access token"), required:
# without it no metadata is loaded and the catalogue stays empty
TMDB_API_KEY=

# Upstream Xtream provider host, without http:// or port (required)
XTREAM_HOST=provider.example.com

# Database password, make up a long one
POSTGRES_PASSWORD=change-me
