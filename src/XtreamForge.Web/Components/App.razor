@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <link rel="stylesheet" href="XtreamForge.Web.styles.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    @* Applies the theme stored by the Fluent UI ThemeService before Blazor starts, avoiding a light/dark flash on load. *@
    <script>
        (function () {
            try {
                var settings = JSON.parse(localStorage.getItem('fluentui-blazor:theme-settings') || '{}');
                var dark = settings.mode === 'dark'
                    || (settings.mode !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (dark) {
                    document.body.setAttribute('data-theme', 'dark');
                }
            } catch (e) {
                // Invalid stored settings: the Fluent UI script applies the default theme.
            }
        })();
    </script>

    @* Read through JS interop by BrowserTimeZone: the server cannot know the time zone of the browser. *@
    <script>
        window.xtreamForge = {
            getTimeZone: function () {
                return Intl.DateTimeFormat().resolvedOptions().timeZone;
            }
        };
    </script>

    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
