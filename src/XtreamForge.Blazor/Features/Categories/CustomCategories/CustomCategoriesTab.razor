@namespace XtreamForge.Blazor.Features.Categories.CustomCategories
@using XtreamForge.Blazor.Components.Shared

<section class="categories-tab-panel">
    <header class="categories-panel-header">
        <div>
            <h2>Global Custom Categories</h2>
            <p class="category-meta">Custom categories are shared across sources for the selected content type and keep stable XtreamForge IDs.</p>
        </div>
        @if (IsRefreshing)
        {
            <div class="categories-count">Refreshing…</div>
        }
    </header>

    <div class="categories-toolbar-grid">
        <label>
            Content Type
            <InputSelect Value="SelectedContentType" ValueChanged="OnSelectedContentTypeChangedAsync">
                <option value="@AdminContentType.Vod">VOD</option>
                <option value="@AdminContentType.Series">Series</option>
            </InputSelect>
        </label>

        <div class="toolbar-actions">
            <button type="button" @onclick="() => OnToggleCreate.InvokeAsync()">
                @(ShowCreateEditor ? "Hide new category" : "+ New category")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message) || !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="panel-feedback">
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="inline-success">@Message</div>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="inline-error">@ErrorMessage</div>
            }
        </div>
    }

    @if (ShowCreateEditor)
    {
        <div class="rule-editor-card">
            <h3>Create custom category</h3>
            <div class="custom-category-create-grid">
                <label>
                    Name
                    <InputText @bind-Value="NewCustomCategory.DisplayName" maxlength="255" placeholder="Movies 4K" disabled="@IsCreating" />
                </label>
                <div class="rule-action-cell">
                    <button type="button" @onclick="() => OnCreate.InvokeAsync()" disabled="@IsCreating">@(IsCreating ? "Saving…" : "Create")</button>
                </div>
            </div>
        </div>
    }

    @if (Rows.Count == 0)
    {
        <div class="empty-state">
            <p>No custom categories created for this content type yet.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="category-grid">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Used By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr @key="row.Summary.Id">
                            <td>
                                <div class="category-name">@row.Summary.DisplayName</div>
                                <div class="category-meta">XtreamForge ID @row.Summary.XtreamForgeCategoryId</div>
                                @if (row.IsEditing)
                                {
                                    <div class="inline-editor-box">
                                        <label>
                                            Name
                                            <InputText @bind-Value="row.DisplayName" maxlength="255" disabled="@row.IsBusy" />
                                        </label>
                                        <div class="inline-editor-actions">
                                            <button type="button" @onclick="() => OnSave.InvokeAsync(row)" disabled="@row.IsBusy">@(row.IsBusy ? "Saving…" : "Save")</button>
                                            <button type="button" class="secondary-button" @onclick="() => OnCancelEdit.InvokeAsync(row)" disabled="@row.IsBusy">Cancel</button>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (row.Summary.UsageCount > 0)
                                {
                                    <div class="usage-cell">
                                        <button type="button" class="link-button" @onclick="() => OnOpenUsages.InvokeAsync(row)">
                                            @row.Summary.UsageCount source categor@(row.Summary.UsageCount == 1 ? "y" : "ies")
                                        </button>
                                        <button type="button" class="icon-button" title="View source category usage" aria-label="View source category usage" @onclick="() => OnOpenUsages.InvokeAsync(row)">
                                            <AppIcon Name="details" />
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="category-meta">Unused</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    @if (!row.IsEditing)
                                    {
                                        <button type="button" class="icon-button" title="Edit custom category" aria-label="Edit custom category" @onclick="() => OnBeginEdit.InvokeAsync(row)" disabled="@row.IsBusy">
                                            <AppIcon Name="edit" />
                                        </button>
                                    }
                                    <button type="button"
                                            class="icon-button danger-button"
                                            title="@(row.Summary.UsageCount > 0 ? "Delete unavailable while category is in use" : "Delete custom category")"
                                            aria-label="Delete custom category"
                                            @onclick="() => OnRequestDelete.InvokeAsync(row)"
                                            disabled="@(row.IsBusy || row.Summary.UsageCount > 0)">
                                        <AppIcon Name="trash" />
                                    </button>
                                </div>
                                @if (row.Summary.UsageCount > 0)
                                {
                                    <div class="category-meta">Delete is available only when unused. Inspect Used By for details.</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Message))
                                {
                                    <div class="@(row.SaveState == MutationFeedbackState.Failed ? "inline-error" : "category-meta")">@row.Message</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter]
    public AdminContentType SelectedContentType { get; set; }

    [Parameter]
    public required IReadOnlyList<CustomCategoryRowState> Rows { get; set; }

    [Parameter]
    public required CustomCategoryEditorState NewCustomCategory { get; set; }

    [Parameter]
    public bool ShowCreateEditor { get; set; }

    [Parameter]
    public bool IsCreating { get; set; }

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnCreate { get; set; }

    [Parameter]
    public EventCallback OnToggleCreate { get; set; }

    [Parameter]
    public EventCallback<AdminContentType> OnContentTypeChanged { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnBeginEdit { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnCancelEdit { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnSave { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnOpenUsages { get; set; }

    [Parameter]
    public EventCallback<CustomCategoryRowState> OnRequestDelete { get; set; }

    private Task OnSelectedContentTypeChangedAsync(AdminContentType value) => OnContentTypeChanged.InvokeAsync(value);
}
