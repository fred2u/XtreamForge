@typeparam TValue

@* Wrapped in a FluentField so that the label and the control line up exactly with the Fluent UI inputs next to it. *@
<FluentField Label="@Label" Disabled="@Disabled" IncludeInputSlot="true">
    <div class="segmented" role="radiogroup" aria-label="@Label">
        @foreach (var option in Options)
        {
            var isActive = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
            <button type="button"
                    role="radio"
                    aria-checked="@(isActive ? "true" : "false")"
                    disabled="@Disabled"
                    class="segmented-item @(isActive ? "is-active" : null)"
                    @onclick="@(() => SelectAsync(option.Value))">
                @if (option.Icon is not null)
                {
                    <FluentIcon Value="@option.Icon" aria-hidden="true" />
                }
                <span>@option.Label</span>
            </button>
        }
    </div>
</FluentField>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<SegmentOption<TValue>> Options { get; set; } = [];

    [Parameter]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task SelectAsync(TValue value)
    {
        if (!EqualityComparer<TValue>.Default.Equals(value, Value))
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}
