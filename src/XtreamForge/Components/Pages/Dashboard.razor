@page "/"
@inject IDbContextFactory<XtreamForgeDbContext> DbContextFactory
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - XtreamForge</PageTitle>

<h1>Dashboard</h1>
<p class="page-subtitle">Early-stage operational view for the simplified XtreamForge web application.</p>

<div class="dashboard-grid">
    <section class="status-card">
        <h2>Application status</h2>
        <p class="status-value">Healthy</p>
        <p>XtreamForge v@(typeof(Program).Assembly.GetName().Version?.ToString() ?? "unknown")</p>
    </section>

    <section class="status-card">
        <h2>Database connectivity</h2>
        <p class="status-value">@_databaseStatus</p>
        <p>@_databaseDetails</p>
    </section>
</div>

@code {
    private string _databaseStatus = "Checking";
    private string _databaseDetails = "Checking database connectivity.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var canConnect = await dbContext.Database.CanConnectAsync();
            var providerDisplayName = dbContext.Database.ProviderName?.Contains("Npgsql", StringComparison.OrdinalIgnoreCase) == true
                ? "PostgreSQL"
                : dbContext.Database.ProviderName?.Contains("Sqlite", StringComparison.OrdinalIgnoreCase) == true
                    ? "SQLite"
                    : "The configured database";

            _databaseStatus = canConnect ? "Connected" : "Unavailable";
            _databaseDetails = canConnect
                ? $"{providerDisplayName} is reachable."
                : $"{providerDisplayName} is not reachable.";
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to verify database connectivity.");
            _databaseStatus = "Unavailable";
            _databaseDetails = "The database connectivity check failed.";
        }
    }
}
